@model GitaWidyaAgniWeb.Models.Persuratan.DokumenVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Arsip Dokumen";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-folder-2-line align-bottom me-1"></i> Arsip Dokumen</h5>
        <p class="gwa-card-intro">Simpan AD/ART, SK, proposal, dan dokumen lain (maks. 20 MB). Visibilitas menentukan siapa yang boleh melihat dokumen di Area Anggota. Hapus dokumen bersifat permanen.</p>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs gwa-tabs mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDokumen" data-tab="Dokumen" type="button" role="tab"><i class="ri-file-text-line me-1"></i>Dokumen</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabKategori" data-tab="Kategori" type="button" role="tab"><i class="ri-price-tag-3-line me-1"></i>Kategori</button></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabDokumen" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Unggah Dokumen", "Dokumen.add(\"Dokumen\")",
                    ("btn-outline-info", "ri-eye-line", "Lihat"),
                    ("btn-outline-secondary", "ri-download-2-line", "Unduh"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah / ganti berkas"),
                    ("btn-outline-danger", "ri-delete-bin-line", "Hapus permanen")) { LegendId = "legendDokumen" }' />
                <div id="targetDokumen" class="mt-3"></div>
            </div>
            <div class="tab-pane fade" id="tabKategori" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Kategori", "Dokumen.add(\"Kategori\")",
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan")) { LegendId = "legendKategori" }' />
                <div id="targetKategori" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.DokumenUrl = {};
        ['ListDokumen', 'AddDokumen', 'EditDokumen', 'SimpanDokumen', 'UpdateDokumen', 'HapusDokumen', 'Unduh',
            'ListKategori', 'AddKategori', 'EditKategori', 'SimpanKategori', 'UpdateKategori', 'HapusKategori'].forEach(function (a) {
            window.DokumenUrl[a.charAt(0).toLowerCase() + a.slice(1)] = '@Url.Action("__")'.replace('__', a);
        });
    </script>
    <script src="~/Scripts/Persuratan/Dokumen.js" asp-append-version="true"></script>
}
