@model GitaWidyaAgniWeb.Models.Pengadaan.PengadaanVM.Terima
@* Penerimaan barang: jumlah per barang (maks. sisa). Barang aset: isi kode aset baru untuk langsung membuat data aset. *@

<div class="gwa-mform" id="pengadaanTerima" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-inbox-archive-line"></i></span>
        <div><div class="gwa-mform-info-title">@Model.Judul</div></div>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <label class="form-label mb-1 fw-medium" for="tglTerima">Tanggal terima</label>
            <input type="date" id="tglTerima" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-8">
            <label class="form-label mb-1 fw-medium" for="penerima">Penerima</label>
            @(Html.DevExtreme().SelectBox().ID("penerima").DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true).Placeholder("Kosong = anggota Anda"))
        </div>
        <div class="col-12">
            <label class="form-label mb-1 fw-medium" for="catatanTerima">Catatan</label>
            <input id="catatanTerima" class="form-control" maxlength="255" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Barang</th><th class="text-center">Sisa</th><th style="width:110px">Diterima</th><th style="width:160px">Kondisi</th><th>Kode Aset Baru</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr class="terima-line" data-id="@i.Id">
                        <td>@i.ItemName</td>
                        <td class="text-center">@(i.Quantity - i.ReceivedQuantity) @i.Unit</td>
                        <td><input type="number" class="form-control form-control-sm t-qty" min="0" max="@(i.Quantity - i.ReceivedQuantity)" value="@(i.Quantity - i.ReceivedQuantity)" aria-label="Jumlah diterima @i.ItemName" /></td>
                        <td>
                            <select class="form-select form-select-sm t-cond" aria-label="Kondisi @i.ItemName">
                                @foreach (var k in Model.KondisiOpsi)
                                {
                                    <option value="@k.Value">@k.Text</option>
                                }
                            </select>
                        </td>
                        <td>
                            @if (i.Aset)
                            {
                                <input class="form-control form-control-sm text-uppercase t-code" maxlength="50" placeholder="Opsional" aria-label="Kode aset @i.ItemName" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Pengadaan.saveReceipt()"><i class="ri-check-line align-bottom me-1"></i> Simpan Penerimaan</button>
    </div>
</div>
