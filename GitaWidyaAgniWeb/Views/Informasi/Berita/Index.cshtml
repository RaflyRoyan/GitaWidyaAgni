@model GitaWidyaAgniWeb.Models.Informasi.BeritaVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Berita";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-newspaper-line align-bottom me-1"></i> Berita &amp; Pengumuman</h5>
        <p class="gwa-card-intro">Tulis berita, pengumuman, dan agenda. Berita publik yang terbit tampil di landing page; berita private hanya untuk anggota yang login.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tulis Berita", "Berita.add()",
            ("btn-outline-info", "ri-external-link-line", "Lihat di situs"),
            ("btn-outline-success", "ri-send-plane-line", "Terbitkan"),
            ("btn-outline-secondary", "ri-arrow-go-back-line", "Tarik ke Draft"),
            ("btn-outline-dark", "ri-archive-line", "Arsipkan"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah"),
            ("btn-outline-danger", "ri-delete-bin-line", "Hapus"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.BeritaUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            delete: '@Url.Action("Delete")',
            terbitkan: '@Url.Action("Terbitkan")',
            tarik: '@Url.Action("Tarik")',
            arsipkan: '@Url.Action("Arsipkan")',
            situs: '@Url.Content("~/berita/")'
        };
    </script>
    <script src="~/Scripts/Informasi/Berita.js" asp-append-version="true"></script>
}
