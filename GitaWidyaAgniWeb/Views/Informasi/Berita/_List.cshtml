@model GitaWidyaAgniWeb.Models.Informasi.BeritaVM.List
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Informasi

@(Html.DevExtreme().DataGrid<BeritaVM.Row>()
    .ID("tblBerita")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Berita")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Title).Caption("Judul").CssClass("fw-medium");
        columns.AddFor(m => m.Kategori).Caption("Kategori");
        columns.AddFor(m => m.Slug).Caption("Slug").Visible(false);
        columns.AddFor(m => m.AuthorName).Caption("Penulis");
        columns.AddFor(m => m.Publik).Caption("Publik").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddFor(m => m.Disorot).Caption("Disorot").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddFor(m => m.PublishedAt).Caption("Terbit").DataType(GridColumnDataType.DateTime).Format("dd MMM yyyy HH:mm");
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Berita.statusTemplate"));
        columns.AddAction("Berita.actionTemplate");
    })
)
