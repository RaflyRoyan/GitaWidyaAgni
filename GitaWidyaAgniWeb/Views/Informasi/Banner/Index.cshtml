@model GitaWidyaAgniWeb.Models.Informasi.BannerVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Banner";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-image-line align-bottom me-1"></i> Banner Landing Page</h5>
        <p class="gwa-card-intro">Slide foto di hero landing page, diurutkan menurut Urutan. Banner tayang bila Aktif dan berada dalam jadwal; tanpa banner tayang, hero menampilkan logo.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tambah Banner", "Banner.add()",
            ("btn-outline-warning", "ri-edit-2-line", "Ubah"),
            ("btn-outline-danger", "ri-delete-bin-line", "Hapus permanen"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.BannerUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            delete: '@Url.Action("Delete")',
            gambar: '@Url.Action("Gambar")'
        };
    </script>
    <script src="~/Scripts/Informasi/Banner.js" asp-append-version="true"></script>
}
