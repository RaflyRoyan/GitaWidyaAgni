@model GitaWidyaAgniWeb.Models.Keuangan.TransaksiVM.ListKategori
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Keuangan

@(Html.DevExtreme().DataGrid<TransaksiVM.KategoriRow>()
    .ID("tblKategori")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Kategori Keuangan")
    .OnRowPrepared("AppUI.inactiveRowPrepared")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Name).Caption("Kategori").CssClass("fw-medium");
        columns.AddFor(m => m.Jenis).Caption("Jenis").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Transaksi.typeTemplate"));
        columns.AddFor(m => m.Aktif).Caption("Aktif").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddAction("Transaksi.masterActionTemplate('Kategori')");
    })
)
