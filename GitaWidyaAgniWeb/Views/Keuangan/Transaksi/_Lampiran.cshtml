@model GitaWidyaAgniWeb.Models.Keuangan.TransaksiVM.Lampiran
@* Lampiran / bukti transaksi (maks. 5 MB per berkas). Transaksi Dibatalkan tidak bisa diberi lampiran. *@

<div class="gwa-mform" id="transaksiLampiran" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-attachment-2"></i></span>
        <div><div class="gwa-mform-info-title">@Model.Nomor</div></div>
    </div>
    @if (Model.BisaUbah)
    {
        <div class="gwa-mform-add">
            <div class="gwa-mform-add-form">
                @(Html.DevExtreme().FileUploader().ID("fileLampiran").UploadMode(FileUploadMode.UseForm).Multiple(false)
                    .MaxFileSize(5 * 1024 * 1024).SelectButtonText("Pilih berkas").LabelText("atau tarik berkas ke sini"))
            </div>
            <button type="button" class="btn btn-outline-primary" onclick="Transaksi.addAttachment()"><i class="ri-upload-2-line align-bottom me-1"></i> Unggah</button>
        </div>
    }
    @if (Model.Rows.Count == 0)
    {
        <p class="text-muted text-center mb-0 py-3">Belum ada lampiran.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var r in Model.Rows)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    <i class="ri-file-text-line fs-18" aria-hidden="true"></i>
                    <a href="@Url.Action("BerkasLampiran", new { key = r.EncDecrKey })" target="_blank" class="flex-grow-1 text-truncate">@r.FileName</a>
                    <small class="text-muted">@r.InsDate.ToString("dd MMM yyyy HH:mm")</small>
                    @if (Model.BisaUbah)
                    {
                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus lampiran" aria-label="Hapus lampiran" onclick="Transaksi.removeAttachment('@r.EncDecrKey')"><i class="ri-delete-bin-line"></i></button>
                    }
                </li>
            }
        </ul>
    }
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
