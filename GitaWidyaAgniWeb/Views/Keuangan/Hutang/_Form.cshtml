@model GitaWidyaAgniWeb.Models.Keuangan.HutangVM.Add
@using GitaWidyaAgniWeb.Models.Keuangan
@* Form bersama Add & Edit hutang. Akun + kategori pinjaman tunai hanya saat dibuat; nominal pinjaman tunai terkunci. *@
@{
    var editModel = Model as HutangVM.Edit;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-bank-card-line"></i></span>
            <div><div class="gwa-mform-info-title">@editModel!.Nomor</div></div>
        </div>
    }
    @(Html.DevExtreme().Form<HutangVM.NewRow>()
        .ID("frmHutang")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.CreditorName).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.CreditorContact).Editor(e => e.TextBox().MaxLength(100));
            items.AddSimpleFor(m => m.Amount).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0").ReadOnly(editModel?.Tunai == true));
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Periode aktif"));
            }
            items.AddSimpleFor(m => m.DebtDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.DueDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(60).MaxLength(500));
            if (!isEdit)
            {
                items.AddGroup().Caption("Pinjaman tunai (opsional)").ColSpan(2).ColCount(2).Items(g =>
                {
                    g.AddSimpleFor(m => m.LoanAccountId).Editor(e => e.SelectBox().DataSource(Model.AkunOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Bukan pinjaman tunai"));
                    g.AddSimpleFor(m => m.LoanCategoryId).Editor(e => e.SelectBox().DataSource(Model.KategoriOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
                });
            }
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Hutang.@(isEdit ? "update" : "save")()"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
