@model GitaWidyaAgniWeb.Models.Akses.UserVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "User";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-user-settings-line align-bottom me-1"></i> Daftar User</h5>
        <p class="gwa-card-intro">Akun login. Role bisa diberikan untuk periode tertentu (berlaku selama periode itu Aktif) atau tanpa periode (selalu berlaku). Akun anggota dihubungkan dari halaman Data Anggota.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tambah User", "User.add()",
            ("btn-outline-success", "ri-shield-user-line", "Role user"),
            ("btn-outline-info", "ri-lock-password-line", "Reset password"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah user"),
            ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan user"))' />

        <div id="target" class="mt-3">
            <p class="text-muted text-center mb-0 py-4">Memuat data user...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.UserUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            hapus: '@Url.Action("Delete")',
            resetPassword: '@Url.Action("ResetPassword")',
            simpanPassword: '@Url.Action("SimpanPassword")',
            role: '@Url.Action("Role")',
            roleList: '@Url.Action("RoleList")',
            tambahRole: '@Url.Action("TambahRole")',
            hapusRole: '@Url.Action("HapusRole")'
        };
    </script>
    <script src="~/Scripts/Akses/User.js" asp-append-version="true"></script>
}
