@model GitaWidyaAgniWeb.Models.Akses.UserVM.ResetPassword
@using GitaWidyaAgniWeb.Models.Akses

<div class="gwa-mform">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-lock-password-line"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.Username</div>
            <div class="gwa-mform-info-meta"><span>Password lama tidak diperlukan. Sampaikan password baru ke pemilik akun.</span></div>
        </div>
    </div>

    @(Html.DevExtreme().Form<UserVM.ResetPassword>()
        .ID("frmPassword")
        .FormData(new UserVM.ResetPassword { Key = Model.Key })
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.PasswordBaru)
                .Editor(e => e.TextBox().Mode(TextBoxMode.Password).InputAttr(new { autocomplete = "new-password" }));
            items.AddSimpleFor(m => m.UlangiPassword)
                .ValidationRules(r => r.AddCompare().ComparisonTarget("User.passwordTarget").Message("Ulangi password tidak sama"))
                .Editor(e => e.TextBox().Mode(TextBoxMode.Password).InputAttr(new { autocomplete = "new-password" }));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="User.savePassword()">
            <i class="ri-lock-password-line align-bottom me-1"></i> Ganti Password
        </button>
    </div>
</div>
