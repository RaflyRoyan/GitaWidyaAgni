@model GitaWidyaAgniWeb.Models.Akses.UserVM.ResetPassword

<form id="frmPassword" data-key="@Model.Key" onsubmit="return false">
    <div class="alert alert-light border small mb-3">
        Password lama tidak diperlukan. Sampaikan password baru ke pemilik akun <b>@Model.Username</b>.
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Password baru</label>
            @(Html.DevExtreme().TextBox().ID("PasswordBaru").Mode(TextBoxMode.Password).InputAttr(new { autocomplete = "new-password" }))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Ulangi password</label>
            @(Html.DevExtreme().TextBox().ID("UlangiPassword").Mode(TextBoxMode.Password).InputAttr(new { autocomplete = "new-password" }))
        </div>
    </div>
</form>
<div class="hstack gap-2 justify-content-end">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    <button type="button" class="btn btn-primary" onclick="fnSimpanPassword()"><i class="ri-lock-password-line me-1"></i>Ganti Password</button>
</div>
