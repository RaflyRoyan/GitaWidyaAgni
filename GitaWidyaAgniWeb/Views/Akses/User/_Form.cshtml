@model GitaWidyaAgniWeb.Models.Akses.UserVM.Form

<form id="frmUser" data-edit="@(Model.IsEdit ? "1" : "0")" onsubmit="return false">
    <div class="row">
        <div class="col-12 mb-3">
            <label class="form-label gwa-required">Username</label>
            @(Html.DevExtreme().TextBox().ID("Username").Value(Model.Username).MaxLength(100)
                .Placeholder("mis. kadiv.brass")
                .InputAttr(new { autocomplete = "off" }))
        </div>
        @if (!Model.IsEdit)
        {
            <div class="col-12 mb-3">
                <label class="form-label gwa-required">Password</label>
                @(Html.DevExtreme().TextBox().ID("Password").Mode(TextBoxMode.Password).MaxLength(100)
                    .InputAttr(new { autocomplete = "new-password" }))
                <small class="text-muted">Minimal 8 karakter.</small>
            </div>
        }
        else
        {
            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                @(Html.DevExtreme().SelectBox().ID("IsActive").Value(Model.IsActive)
                    .DataSource(GitaWidyaAgniWeb.Models.GwaVM.OpsiAktif).ValueExpr("Value").DisplayExpr("Text"))
            </div>
        }
    </div>
</form>
<div class="hstack gap-2 justify-content-end">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    <button type="button" class="btn btn-primary" onclick="fnSimpan()"><i class="ri-save-line me-1"></i>Simpan</button>
</div>
