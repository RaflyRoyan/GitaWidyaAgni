@model GitaWidyaAgniWeb.Models.Akses.UserVM.Add
@using GitaWidyaAgniWeb.Models.Akses
@* Form bersama modal Add & Edit User. Password hanya di Add; status hanya di Edit (user baru selalu Aktif). *@

@{
    var editModel = Model as UserVM.Edit;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-user-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Username</div>
                <div class="gwa-mform-info-meta">
                    <span>Anggota <b>@(editModel!.NamaAnggota ?? "-")</b></span>
                    <span>Login terakhir <b>@(editModel.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "belum pernah")</b></span>
                </div>
            </div>
        </div>
    }

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Akun login</span>
        <span class="gwa-mform-section-hint">Username dipakai saat login</span>
    </div>
    @(Html.DevExtreme().Form<UserVM.NewRow>()
        .ID("frmUser")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(1)
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Username)
                .Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. kadiv.brass").InputAttr(new { autocomplete = "off" }));
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.Password)
                    .HelpText("Minimal 8 karakter.")
                    .ValidationRules(r =>
                    {
                        r.AddRequired().Message("Password harus diisi");
                        r.AddStringLength().Min(8).Message("Password minimal 8 karakter");
                    })
                    .Editor(e => e.TextBox().Mode(TextBoxMode.Password).MaxLength(100).InputAttr(new { autocomplete = "new-password" }));
            }
            else
            {
                items.AddSimpleFor(m => m.IsActive)
                    .Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="User.@(isEdit ? "update" : "save")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
