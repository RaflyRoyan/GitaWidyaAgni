@model GitaWidyaAgniWeb.Models.Akses.UserVM.RoleIndex
@using GitaWidyaAgniWeb.Models.Akses
@* Modal role user: ringkasan, panel tambah role, grid role (_RoleList, dimuat ulang setelah tambah / cabut). *@

<div class="gwa-mform" id="userRole" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-shield-user-line"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.Username</div>
            <div class="gwa-mform-info-meta"><span>Role tanpa periode selalu berlaku; role berperiode hanya berlaku selama periode itu Aktif.</span></div>
        </div>
    </div>

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Tambah role</span>
    </div>
    <div class="gwa-mform-add">
        <div class="gwa-mform-add-form">
            @(Html.DevExtreme().Form<UserVM.TambahRoleInput>()
                .ID("frmUserRole")
                .FormData(Model.Input)
                .LabelLocation(FormLabelLocation.Top)
                .ShowColonAfterLabel(false)
                .ColCount(2)
                .ColCountByScreen(c => c.Xs(1).Sm(1))
                .Items(items =>
                {
                    items.AddSimpleFor(m => m.RoleId)
                        .ValidationRules(r => r.AddRequired().Message("Pilih role"))
                        .Editor(e => e.SelectBox().DataSource(Model.RoleOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih role..."));
                    items.AddSimpleFor(m => m.PeriodId)
                        .Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Tanpa periode (selalu berlaku)"));
                })
            )
        </div>
        <button type="button" class="btn btn-outline-primary" onclick="User.addRole()"><i class="ri-add-line align-bottom me-1"></i> Tambah</button>
    </div>

    <div id="userRoleTarget">
        <partial name="~/Views/Akses/User/_RoleList.cshtml" model="Model.List" />
    </div>

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
