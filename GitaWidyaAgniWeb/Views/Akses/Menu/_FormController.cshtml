@model GitaWidyaAgniWeb.Models.Akses.MenuVM.AddController
@using GitaWidyaAgniWeb.Models.Akses
@* Form bersama modal Add & Edit Controller. Status hanya di Edit. *@

@{
    var editModel = Model as MenuVM.EditController;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-code-box-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Name</div>
                <div class="gwa-mform-info-meta"><span>Aksi <b>@(string.IsNullOrEmpty(editModel!.Aksi) ? "-" : editModel.Aksi)</b></span></div>
            </div>
        </div>
    }

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Identitas controller</span>
        <span class="gwa-mform-section-hint">Sama persis dengan nama class tanpa "Controller"</span>
    </div>
    @(Html.DevExtreme().Form<MenuVM.NewController>()
        .ID("frmController")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Kegiatan"));
            items.AddSimpleFor(m => m.IndexAction).Editor(e => e.TextBox().MaxLength(100));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )
    @if (!isEdit)
    {
        <p class="gwa-mform-note">Aksi halaman utama otomatis didaftarkan. Tambahkan aksi lain lewat tombol Daftar aksi.</p>
    }

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Menu.@(isEdit ? "updateController" : "saveController")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
