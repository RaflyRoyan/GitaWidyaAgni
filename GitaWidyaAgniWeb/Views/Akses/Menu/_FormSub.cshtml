@model GitaWidyaAgniWeb.Models.Akses.MenuVM.FormSub

<form id="frmSub" data-edit="@(Model.IsEdit ? "1" : "0")" onsubmit="return false">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Nama</label>
            @(Html.DevExtreme().TextBox().ID("SubName").Value(Model.Name).MaxLength(100))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Controller</label>
            @(Html.DevExtreme().SelectBox().ID("SubControllerId").Value(Model.ControllerId)
                .DataSource(Model.ControllerList).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih controller..."))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Ikon (Remix Icon)</label>
            @(Html.DevExtreme().TextBox().ID("SubIcon").Value(Model.Icon).MaxLength(100).Placeholder("ri-file-list-line"))
        </div>
        @if (Model.IsEdit)
        {
            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                @(Html.DevExtreme().SelectBox().ID("SubIsActive").Value(Model.IsActive)
                    .DataSource(GitaWidyaAgniWeb.Models.GwaVM.OpsiAktif).ValueExpr("Value").DisplayExpr("Text"))
            </div>
        }
        <div class="col-12 mb-3">
            <label class="form-label">Keterangan</label>
            @(Html.DevExtreme().TextBox().ID("SubDescription").Value(Model.Description).MaxLength(200))
        </div>
    </div>
</form>
<div class="hstack gap-2 justify-content-end">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    <button type="button" class="btn btn-primary" onclick="fnSimpanSub()"><i class="ri-save-line me-1"></i>Simpan</button>
</div>
