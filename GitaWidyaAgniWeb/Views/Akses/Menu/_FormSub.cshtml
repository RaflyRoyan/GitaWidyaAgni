@model GitaWidyaAgniWeb.Models.Akses.MenuVM.AddSub
@using GitaWidyaAgniWeb.Models.Akses
@* Form bersama modal Add & Edit Sub Menu. Status hanya di Edit. *@

@{
    var isEdit = Model is MenuVM.EditSub;
}

<div class="gwa-mform">
    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Sub menu</span>
        <span class="gwa-mform-section-hint">Dimasukkan ke grup lewat tab Header Menu</span>
    </div>
    @(Html.DevExtreme().Form<MenuVM.NewSub>()
        .ID("frmSub")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100));
            items.AddSimpleFor(m => m.ControllerId)
                .Editor(e => e.SelectBox().DataSource(Model.ControllerList).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih controller..."));
            items.AddSimpleFor(m => m.Icon).Editor(e => e.TextBox().MaxLength(100).Placeholder("ri-file-list-line"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Menu.@(isEdit ? "updateSub" : "saveSub")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
