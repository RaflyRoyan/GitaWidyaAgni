@model GitaWidyaAgniWeb.Models.Akses.MenuVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Menu & Controller";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-layout-left-line align-bottom me-1"></i> Menu &amp; Controller</h5>
        <p class="gwa-card-intro">Controller = halaman web, aksi = tombol/endpoint yang hak aksesnya dicek. Header menu tampil di sidebar: dengan controller menjadi link langsung, tanpa controller menjadi grup berisi sub menu.</p>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs gwa-tabs mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabController" type="button" role="tab"><i class="ri-code-box-line me-1"></i>Controller &amp; Aksi</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHeader" type="button" role="tab"><i class="ri-layout-left-line me-1"></i>Header Menu</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSub" type="button" role="tab"><i class="ri-list-check me-1"></i>Sub Menu</button></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabController" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Controller", "Menu.addController()",
                    ("btn-outline-success", "ri-list-settings-line", "Daftar aksi"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah controller"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan controller")) { LegendId = "legendController" }' />
                <div id="targetController" class="mt-3">
                    <p class="text-muted text-center mb-0 py-4">Memuat data controller...</p>
                </div>
            </div>
            <div class="tab-pane fade" id="tabHeader" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Header Menu", "Menu.addHeader()",
                    ("btn-outline-success", "ri-list-ordered", "Atur sub menu grup"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah header"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan header")) { LegendId = "legendHeader" }' />
                <div id="targetHeader" class="mt-3">
                    <p class="text-muted text-center mb-0 py-4">Memuat data header menu...</p>
                </div>
            </div>
            <div class="tab-pane fade" id="tabSub" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Sub Menu", "Menu.addSub()",
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah sub menu"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan sub menu")) { LegendId = "legendSub" }' />
                <div id="targetSub" class="mt-3">
                    <p class="text-muted text-center mb-0 py-4">Memuat data sub menu...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.MenuUrl = {
            listController: '@Url.Action("ListController")', addController: '@Url.Action("AddController")', editController: '@Url.Action("EditController")',
            simpanController: '@Url.Action("SimpanController")', updateController: '@Url.Action("UpdateController")', hapusController: '@Url.Action("DeleteController")',
            aksi: '@Url.Action("DaftarAksi")', simpanAksi: '@Url.Action("SimpanAksi")',
            listHeader: '@Url.Action("ListHeader")', addHeader: '@Url.Action("AddHeader")', editHeader: '@Url.Action("EditHeader")',
            simpanHeader: '@Url.Action("SimpanHeader")', updateHeader: '@Url.Action("UpdateHeader")', hapusHeader: '@Url.Action("DeleteHeader")',
            detail: '@Url.Action("Detail")', simpanDetail: '@Url.Action("SimpanDetail")',
            listSub: '@Url.Action("ListSub")', addSub: '@Url.Action("AddSub")', editSub: '@Url.Action("EditSub")',
            simpanSub: '@Url.Action("SimpanSub")', updateSub: '@Url.Action("UpdateSub")', hapusSub: '@Url.Action("DeleteSub")'
        };
    </script>
    <script src="~/Scripts/Akses/Menu.js" asp-append-version="true"></script>
}
