@model GitaWidyaAgniWeb.Models.Akses.MenuVM.AddHeader
@using GitaWidyaAgniWeb.Models.Akses
@* Form bersama modal Add & Edit Header Menu. Status hanya di Edit. *@

@{
    var isEdit = Model is MenuVM.EditHeader;
}

<div class="gwa-mform">
    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Header menu</span>
        <span class="gwa-mform-section-hint">Dengan controller = link langsung; tanpa controller = grup sub menu</span>
    </div>
    @(Html.DevExtreme().Form<MenuVM.NewHeader>()
        .ID("frmHeader")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100));
            items.AddSimpleFor(m => m.Section).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Keuangan"));
            items.AddSimpleFor(m => m.ControllerId)
                .Editor(e => e.SelectBox().DataSource(Model.ControllerList).ValueExpr("Value").DisplayExpr("Text")
                    .SearchEnabled(true).ShowClearButton(true).Placeholder("Tidak ada (grup sub menu)"));
            items.AddSimpleFor(m => m.Icon).Editor(e => e.TextBox().MaxLength(100).Placeholder("ri-wallet-3-line"));
            items.AddSimpleFor(m => m.Seq).Editor(e => e.NumberBox().Min(0).ShowSpinButtons(true).Format("#0"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Menu.@(isEdit ? "updateHeader" : "saveHeader")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
