@model GitaWidyaAgniWeb.Models.Akses.MenuVM.FormHeader

<form id="frmHeader" data-edit="@(Model.IsEdit ? "1" : "0")" onsubmit="return false">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Nama</label>
            @(Html.DevExtreme().TextBox().ID("HdrName").Value(Model.Name).MaxLength(100))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Judul bagian sidebar</label>
            @(Html.DevExtreme().TextBox().ID("HdrSection").Value(Model.Section).MaxLength(100).Placeholder("mis. Keuangan"))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Halaman langsung (controller)</label>
            @(Html.DevExtreme().SelectBox().ID("HdrControllerId").Value(Model.ControllerId)
                .DataSource(Model.ControllerList).ValueExpr("Value").DisplayExpr("Text")
                .SearchEnabled(true).ShowClearButton(true).Placeholder("Tidak ada (grup sub menu)"))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Ikon (Remix Icon)</label>
            @(Html.DevExtreme().TextBox().ID("HdrIcon").Value(Model.Icon).MaxLength(100).Placeholder("ri-wallet-3-line"))
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label gwa-required">Urutan</label>
            @(Html.DevExtreme().NumberBox().ID("HdrSeq").Value(Model.Seq).Min(0).ShowSpinButtons(true).Format("#0"))
        </div>
        @if (Model.IsEdit)
        {
            <div class="col-md-4 mb-3">
                <label class="form-label">Status</label>
                @(Html.DevExtreme().SelectBox().ID("HdrIsActive").Value(Model.IsActive)
                    .DataSource(GitaWidyaAgniWeb.Models.GwaVM.OpsiAktif).ValueExpr("Value").DisplayExpr("Text"))
            </div>
        }
        <div class="col-12 mb-3">
            <label class="form-label">Keterangan</label>
            @(Html.DevExtreme().TextBox().ID("HdrDescription").Value(Model.Description).MaxLength(200))
        </div>
    </div>
</form>
<div class="hstack gap-2 justify-content-end">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    <button type="button" class="btn btn-primary" onclick="fnSimpanHeader()"><i class="ri-save-line me-1"></i>Simpan</button>
</div>
