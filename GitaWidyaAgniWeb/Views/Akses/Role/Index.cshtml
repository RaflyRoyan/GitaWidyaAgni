@model GitaWidyaAgniWeb.Models.Akses.RoleVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Role & Hak Akses";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-shield-keyhole-line align-bottom me-1"></i> Daftar Role</h5>
        <p class="gwa-card-intro">Role menentukan menu sidebar dan aksi yang boleh dipakai user. Aksi yang belum diberikan ke role mana pun hanya bisa dibuka SUPERADMIN.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tambah Role", "Role.add()",
            ("btn-outline-success", "ri-shield-keyhole-line", "Hak akses"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah role"),
            ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan role"))' />

        <div id="target" class="mt-3">
            <p class="text-muted text-center mb-0 py-4">Memuat data role...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.RoleUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            hapus: '@Url.Action("Delete")',
            akses: '@Url.Action("Akses")',
            simpanAkses: '@Url.Action("SimpanAkses")'
        };
    </script>
    <script src="~/Scripts/Akses/Role.js" asp-append-version="true"></script>
}
