@model GitaWidyaAgniWeb.Models.Akses.RoleVM.List
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Akses

@(Html.DevExtreme().DataGrid<RoleVM.Row>()
    .ID("tblGrid")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Daftar Role")
    .OnRowPrepared("AppUI.inactiveRowPrepared")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Code).Caption("Kode").CellTemplate(new JS("AppUI.codeTemplate"));
        columns.AddFor(m => m.Name).Caption("Nama").CssClass("fw-medium");
        columns.AddFor(m => m.Description).Caption("Keterangan");
        columns.AddFor(m => m.JumlahUser).Caption("User").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.countBadgeTemplate"));
        columns.AddFor(m => m.Aktif).Caption("Aktif").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddAction("Role.actionTemplate");
    })
)
