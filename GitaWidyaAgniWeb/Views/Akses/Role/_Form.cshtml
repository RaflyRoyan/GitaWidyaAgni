@model GitaWidyaAgniWeb.Models.Akses.RoleVM.Add
@using GitaWidyaAgniWeb.Models.Akses
@* Form bersama modal Add & Edit Role. Kode disimpan huruf besar; status hanya di Edit (role baru selalu Aktif). *@

@{
    var editModel = Model as RoleVM.Edit;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-shield-keyhole-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Name</div>
                <div class="gwa-mform-info-meta">
                    <span>Kode <b>@Model.Row.Code</b></span>
                    <span>Dipakai <b>@editModel!.JumlahUser</b> user</span>
                </div>
            </div>
        </div>
    }

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Identitas role</span>
        <span class="gwa-mform-section-hint">Kode dipakai di sistem, nama tampil di profil user</span>
    </div>
    @(Html.DevExtreme().Form<RoleVM.NewRow>()
        .ID("frmRole")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Code)
                .Editor(e => e.TextBox().MaxLength(50).Placeholder("mis. BENDAHARA").InputAttr(new { style = "text-transform:uppercase" }));
            items.AddSimpleFor(m => m.Name).ColSpan(2)
                .Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Bendahara Umum"));
            items.AddSimpleFor(m => m.Description).ColSpan(3)
                .Editor(e => e.TextArea().Height(80).MaxLength(255).Placeholder("Tugas atau cakupan role ini"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive)
                    .Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Role.@(isEdit ? "update" : "save")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
