@model GitaWidyaAgniWeb.Models.Kemitraan.SponsorshipVM.AddPaket
@using GitaWidyaAgniWeb.Models.Kemitraan
@* Benefit paket diatur di form Ubah (paket harus disimpan dulu). Benefit disalin ke sponsorship baru yang memakai paket ini. *@
@{ var isEdit = Model is SponsorshipVM.EditPaket; }

<div class="gwa-mform" id="paketForm" data-key="@Model.Key">
    @(Html.DevExtreme().Form<SponsorshipVM.NewPaket>()
        .ID("frmPaket")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Gold"));
            items.AddSimpleFor(m => m.Price).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0"));
            items.AddSimpleFor(m => m.SeqNo).Editor(e => e.NumberBox().Min(0).ShowSpinButtons(true).Format("#0"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )
    @if (isEdit)
    {
        <div class="gwa-mform-section"><span class="gwa-mform-section-title">Benefit paket</span></div>
        <div class="gwa-mform-add">
            <div class="gwa-mform-add-form d-flex gap-2">
                <input id="paketBenefit" class="form-control" maxlength="200" placeholder="Benefit baru" aria-label="Benefit baru" />
            </div>
            <button type="button" class="btn btn-outline-primary" onclick="Sponsorship.addPackageBenefit()"><i class="ri-add-line align-bottom me-1"></i> Tambah</button>
        </div>
        <ul class="list-group mb-2">
            @foreach (var b in Model.Benefit)
            {
                <li class="list-group-item d-flex align-items-center">
                    <span class="flex-grow-1">@b.Title</span>
                    <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus benefit" aria-label="Hapus benefit" onclick="Sponsorship.removePackageBenefit('@b.EncDecrKey')"><i class="ri-delete-bin-line"></i></button>
                </li>
            }
        </ul>
    }
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
        <button type="button" class="btn btn-success" onclick="Sponsorship.save('Paket', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
