@model GitaWidyaAgniWeb.Models.Organisasi.PeriodeVM.AddSerahTerima
@using GitaWidyaAgniWeb.Models.Organisasi
@* Form bersama Add & Edit serah terima. Periode asal tetap setelah dibuat. LPJ dikirim lewat FormData. *@

@{
    var editModel = Model as PeriodeVM.EditSerahTerima;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-exchange-box-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">Dari @editModel!.FromPeriod</div>
                <div class="gwa-mform-info-meta"><span>Status <b>@editModel.StatusText</b></span></div>
            </div>
        </div>
    }

    @(Html.DevExtreme().Form<PeriodeVM.NewSerahTerima>()
        .ID("frmSerahTerima")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.FromPeriodId)
                    .Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.ToPeriodId)
                .Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").Placeholder("Periode baru (Draft)"));
            items.AddSimpleFor(m => m.HandoverNumber)
                .Editor(e => e.TextBox().MaxLength(100).Placeholder("Kosong = dibuat otomatis saat disetujui"));
            items.AddSimpleFor(m => m.HandoverDate)
                .Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.HandedByMemberId)
                .Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.ReceivedByMemberId)
                .Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.Notes).ColSpan(2)
                .Editor(e => e.TextArea().Height(70).MaxLength(1000));
        })
    )

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Berkas LPJ</span>
        <span class="gwa-mform-section-hint">Laporan pertanggungjawaban periode asal (opsional)</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.LpjFileName))
    {
        <div class="gwa-mform-note d-flex align-items-center gap-2">
            <i class="ri-file-text-line"></i><span>@Model.LpjFileName</span>
            <label class="ms-auto form-check-label"><input type="checkbox" class="form-check-input me-1" id="chkHapusLpj" /> Hapus berkas</label>
        </div>
    }
    @(Html.DevExtreme().FileUploader().ID("fileLpj").UploadMode(FileUploadMode.UseForm).Multiple(false)
        .MaxFileSize(20 * 1024 * 1024).SelectButtonText("Pilih berkas").LabelText("atau tarik berkas ke sini"))

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Periode.saveHandover(@(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
