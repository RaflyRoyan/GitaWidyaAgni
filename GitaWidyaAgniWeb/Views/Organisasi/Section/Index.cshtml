@model GitaWidyaAgniWeb.Models.Organisasi.SectionVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Section";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-music-2-line align-bottom me-1"></i> Daftar Section</h5>
        <p class="gwa-card-intro">Section musik (Brass, Battery, Front Ensemble, Colour Guard). Semua anggota punya satu section dan bisa dipindah kapan saja; riwayatnya tersimpan. Berbeda dengan divisi, yang hanya berisi anggota pilihan Ketua Umum.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tambah Section", "Section.add()",
            ("btn-outline-success", "ri-group-line", "Anggota & riwayat section"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah section"),
            ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan section"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.SectionUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            hapus: '@Url.Action("Delete")',
            anggota: '@Url.Action("Anggota")'
        };
        window.SectionRiwayatUrl = {
            sectionList: '@Url.Action("AnggotaList")',
            memberList: '@Url.Action("RiwayatAnggotaList")',
            pindah: '@Url.Action("Pindah")',
            hapus: '@Url.Action("HapusRiwayat")'
        };
    </script>
    <script src="~/Scripts/Organisasi/SectionRiwayat.js" asp-append-version="true"></script>
    <script src="~/Scripts/Organisasi/Section.js" asp-append-version="true"></script>
}
