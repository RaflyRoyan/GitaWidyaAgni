@model GitaWidyaAgniWeb.Models.Organisasi.SectionVM.Add
@using GitaWidyaAgniWeb.Models.Organisasi
@* Form bersama modal Add & Edit Section. Status hanya di Edit. *@

@{
    var isEdit = Model is SectionVM.Edit;
}

<div class="gwa-mform">
    @(Html.DevExtreme().Form<SectionVM.NewRow>()
        .ID("frmSection")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).ColSpan(2)
                .Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Brass"));
            items.AddSimpleFor(m => m.SortOrder)
                .Editor(e => e.NumberBox().Min(0).Max(9999).ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.Description).ColSpan(3)
                .Editor(e => e.TextArea().Height(70).MaxLength(255).Placeholder("mis. Trumpet, mellophone, baritone, tuba"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive)
                    .Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Section.@(isEdit ? "update" : "save")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
