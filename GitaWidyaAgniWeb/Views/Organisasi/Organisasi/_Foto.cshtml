@model GitaWidyaAgniWeb.Models.Organisasi.OrganisasiVM.Foto
@* Galeri foto organisasi; gambar dari Landing/OrganizationImage/{seq}. *@

@if (Model.Items.Count == 0)
{
    <p class="text-muted text-center mb-0 py-4">Belum ada foto organisasi.</p>
}
else
{
    <div class="row g-3">
        @foreach (var f in Model.Items)
        {
            <div class="col-6 col-md-4 col-xl-3">
                <div class="border rounded overflow-hidden position-relative">
                    <img src="@Url.Action("OrganizationImage", "Landing", new { area = "", id = f.SeqPhoto })?v=@f.Versi" alt="Foto organisasi @f.SeqPhoto" class="w-100" style="aspect-ratio:4/3;object-fit:cover" loading="lazy" />
                    <div class="d-flex align-items-center justify-content-between px-2 py-1 small bg-light">
                        <span class="text-muted">#@f.SeqPhoto · @((f.Ukuran / 1024.0).ToString("0")) KB</span>
                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus foto" aria-label="Hapus foto" onclick="Organisasi.removePhoto(@f.SeqPhoto)"><i class="ri-delete-bin-line"></i></button>
                    </div>
                </div>
            </div>
        }
    </div>
}
