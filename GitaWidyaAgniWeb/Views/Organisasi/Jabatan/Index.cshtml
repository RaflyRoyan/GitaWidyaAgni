@model GitaWidyaAgniWeb.Models.Organisasi.JabatanVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Jabatan";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-medal-line align-bottom me-1"></i> Daftar Jabatan</h5>
        <p class="gwa-card-intro">Jabatan dipakai saat menugaskan pengurus. Jabatan inti (mis. Ketua Umum) hanya boleh dipegang satu orang per periode dan divisi.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Tambah Jabatan", "Jabatan.add()",
            ("btn-outline-warning", "ri-edit-2-line", "Ubah jabatan"),
            ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan jabatan"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.JabatanUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            hapus: '@Url.Action("Delete")'
        };
    </script>
    <script src="~/Scripts/Organisasi/Jabatan.js" asp-append-version="true"></script>
}
