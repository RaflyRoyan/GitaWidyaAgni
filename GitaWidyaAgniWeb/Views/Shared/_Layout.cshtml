@inject GitaWidyaAgniWeb.Infrastructure.AccessService Access
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var appName = Access.GetAppName();
}
<!DOCTYPE html>
<html lang="id" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | @appName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="@appName" name="description" />
    <meta content="@appName" name="author" />
    @* Token antiforgery untuk request AJAX (gwa-crud.js mengirimnya di header RequestVerificationToken). *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/favicon.ico">
    <meta name="theme-color" content="#fbf8f2" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
    @*DEVEXTREME 23.2 — dimuat di head karena helper Razor (DataGrid, TextBox, ...) menulis script inline di body.
      Hanya ada satu jQuery (milik DevExtreme); jangan memuat jQuery lain sesudahnya, plugin dx* terdaftar di jQuery ini.*@
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/Scripts/Shared/dx.messages.id.js" asp-append-version="true"></script>
    @* Handler export grid (Excel + PDF) global: gridExport, dipakai DevExtremeExtensions.ListGrid. *@
    <script src="~/js/grid-export.js" asp-append-version="true"></script>
    @*VELZON CSS — versi warna GWA (*.gwa.min.css dibuat dari file asli dengan warna diganti)*@
    <script src="~/assets/js/layout.js"></script>
    <link href="~/assets/css/bootstrap.gwa.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.gwa.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.gwa.min.css" rel="stylesheet" />

    @*PLUGIN CSS*@
    <link href="~/assets/js/jquery-ui.css" rel="stylesheet" />
    <link href="~/assets/css/spinner.css" id="app-style" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/filepond/filepond.min.css" rel="stylesheet" />
    <link href="~/assets/libs/filepond-plugin-image-preview/filepond-plugin-image-preview.min.css" rel="stylesheet" />
    <link href="~/assets/libs/dropzone/dropzone.css" rel="stylesheet" />
    <link href="~/assets/libs/flatpickr/themes/material_blue.css" rel="stylesheet" />
    <link href="~/assets/libs/swiper/swiper-bundle.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <script src="~/assets/js/modernizr-2.8.3.js"></script>
    <style type="text/css">
        .card-preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: #ffffff;
        }

        #spiner {
            position: absolute;
            left: 50%;
            top: 40%;
            transform: translate(-50%,-50%);
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg)
            }
        }

        #loading1 {
            background-color: black;
            opacity: 0.5;
            z-index: 9999;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            position: fixed;
        }

        .spinner, .spinner::before, .spinner::after {
            content: '';
            display: block;
            border: 4px solid transparent;
            border-radius: 50%;
            animation: spin infinite linear 2s;
            position: absolute;
        }

        .spinner {
            width: 100px;
            height: 100px;
            border-top-color: orange;
            top: calc(50% - 50px);
            left: calc(50% - 50px);
        }

        .teks h2 {
            font-family: Calibri;
            color: #a9a4ff;
            position: fixed;
            margin-top: 15px;
            margin-left: -20px;
            top: calc(50% - 50px);
            left: calc(50% - 50px);
            text-align: center;
        }

        .spinner::before {
            border-top-color: magenta;
            animation-duration: 4s;
            top: 2px;
            bottom: 2px;
            left: 2px;
            right: 2px;
        }

        .spinner::after {
            border-top-color: cyan;
            top: 8px;
            bottom: 8px;
            left: 8px;
            right: 8px;
        }
    </style>
    @* Tema GWA dimuat paling akhir supaya menimpa gaya plugin & loader di atas. *@
    <link href="~/css/gwa-theme.css" rel="stylesheet" asp-append-version="true" />
    @* data-sidebar="dark" hanya agar Velzon memakai teks putih & logo-light; warnanya gradasi brand di gwa-sidebar.css *@
    <link href="~/css/gwa-sidebar.css" rel="stylesheet" asp-append-version="true" />
    @* Tema DevExtreme sama dengan SurabayaTaxWeb: Material Blue Light Compact, dimuat sesudah CSS Velzon
       (SurabayaTaxWeb menambahkannya lewat assets/js/app.js loadCSSDevExtreme; di sini statis karena tidak ada mode gelap). *@
    <link href="~/css/devextreme/dx.material.blue.light.compact.css" rel="stylesheet" />
    <link href="~/css/gwa-devextreme.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="loader" class="loader" style="display: block">
        <div class="logo_sby">            
            <img src="@Url.Action("Logo", "Brand", new { area = "" })" alt="@appName" height="100" />
        </div>
    </div>
    <div id="layout-wrapper">
        <partial name="_Header" />
        <partial name="_Navbar" />
        <partial name="_Modal" />
        @Html.AntiForgeryToken()

        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    @* Judul + breadcrumb otomatis dari route/ViewData (ViewComponents/PageTitle.cs) *@
                    @await Component.InvokeAsync(nameof(GitaWidyaAgniWeb.ViewComponents.PageTitle))
                    @RenderBody()
                </div>
                <!-- container-fluid -->
            </div>
            <!-- End Page-content -->
            <partial name="_Footer" />
        </div>
    </div>

    <div id="loading1" style="display:none">
        <div class="spinner">
        </div>
        <div class="teks">
            <h2></h2>
        </div>
    </div>

    <button onclick="topFunction()" class="btn btn-danger btn-icon" id="back-to-top">
        <i class="ri-arrow-up-line"></i>
    </button>
    
    @*VELZON JS*@

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/feather-icons/feather.min.js"></script>
    <script src="~/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/assets/js/plugins.js"></script>
    <script src="~/assets/js/app.js"></script>

    @*PLUGIN JS*@
    <script src="~/assets/js/jquery.validate.js"></script>
    <script src="~/assets/js/jquery-ui.js"></script>
    <script src="~/assets/libs/dropzone/dropzone-min.js"></script>
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/libs/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/js/spinner.js"></script>
    <script src="~/assets/libs/filepond/filepond.min.js"></script>
    <script src="~/assets/libs/filepond-plugin-image-preview/filepond-plugin-image-preview.min.js"></script>
    <script src="~/assets/libs/filepond-plugin-file-validate-size/filepond-plugin-file-validate-size.min.js"></script>
    <script src="~/assets/libs/filepond-plugin-image-exif-orientation/filepond-plugin-image-exif-orientation.min.js"></script>
    <script src="~/assets/libs/filepond-plugin-file-encode/filepond-plugin-file-encode.min.js"></script>
    <script>
        // Sidebar (model SurabayaTaxWeb): judul panel melayang dari teks menu, dan saat sidebar diciutkan
        // panel paling bawah digeser ke atas supaya tidak terpotong layar.
        function fnInitSidebarMenu() {
            document.querySelectorAll('.navbar-menu .navbar-nav .nav-item').forEach(function (item) {
                var link = item.querySelector(':scope > a.menu-link');
                var dropdown = item.querySelector(':scope > .menu-dropdown');
                if (!link || !dropdown) return;
                var span = link.querySelector('span');
                if (span) dropdown.setAttribute('data-menu-title', span.textContent.trim());
                item.addEventListener('mouseenter', function () {
                    dropdown.style.removeProperty('top');
                    if (document.documentElement.getAttribute('data-sidebar-size') !== 'sm') return;
                    var rect = dropdown.getBoundingClientRect();
                    var lebih = Math.min(rect.bottom - (window.innerHeight - 8), rect.top - 8);
                    if (lebih > 0) dropdown.style.setProperty('top', (-lebih) + 'px', 'important');
                });
            });
        }
        document.addEventListener('DOMContentLoaded', fnInitSidebarMenu);
    </script>
    <script src="~/js/devextreme/exceljs.min.js"></script>
    <script src="~/js/devextreme/FileSaver.min.js"></script>
    <script src="~/js/devextreme/jspdf.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
