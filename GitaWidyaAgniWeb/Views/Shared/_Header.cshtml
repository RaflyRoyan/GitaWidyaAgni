@using GitaWidyaAgniWeb.Infrastructure
@inject AccessService Access
@{
    // Model header mengikuti SurabayaTaxWeb: hamburger kiri; kanan fullscreen + dropdown user (avatar inisial, nama, peran).
    var profile = Access.GetProfile(User.GetUserId());
    var displayName = profile?.DisplayName ?? User.GetUsername();
    var roleText = profile == null || profile.RoleNames.Count == 0 ? "Pengguna" : string.Join(", ", profile.RoleNames);
    var initials = string.Join("", (string.IsNullOrWhiteSpace(displayName) ? "-" : displayName)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));
}
<header id="page-topbar" class="topbar-shadow">
    <div class="layout-width">
        <div class="navbar-header">
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-sm px-3 fs-16 header-item vertical-menu-btn topnav-hamburger" id="topnav-hamburger-icon" aria-label="Buka/tutup menu">
                    <span class="hamburger-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>
                <span class="gwa-topbar-title d-none d-md-inline">@ViewData["Title"]</span>
            </div>

            <div class="d-flex align-items-center">
                <div class="ms-1 header-item d-none d-sm-flex">
                    <a href="@Url.Action("Index", "Landing", new { area = "" })" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" title="Lihat beranda publik" aria-label="Lihat beranda publik">
                        <i class="ri-global-line fs-22" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="ms-1 header-item d-none d-sm-flex">
                    <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" data-toggle="fullscreen" title="Layar penuh" aria-label="Layar penuh">
                        <i class="bx bx-fullscreen fs-22" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="dropdown ms-sm-3 header-item topbar-user">
                    <button type="button" class="btn" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Menu akun">
                        <span class="d-flex align-items-center">
                            <span class="header-avatar-inisial rounded-circle header-profile-user" aria-hidden="true">@initials</span>
                            <span class="text-start ms-xl-2">
                                <span class="d-none d-xl-inline-block ms-1 fw-medium user-name-text">@displayName</span>
                                <span class="d-none d-xl-block ms-1 fs-12 text-muted user-name-sub-text">@roleText</span>
                            </span>
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <h6 class="dropdown-header">Selamat datang, @displayName</h6>
                        <span class="dropdown-item-text fs-12 text-muted pt-0">@User.GetUsername() · @roleText</span>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="mdi mdi-view-dashboard-outline text-muted fs-16 align-middle me-1" aria-hidden="true"></i> <span class="align-middle">Dashboard</span>
                        </a>
                        <a class="dropdown-item" href="@Url.Action("Index", "Landing", new { area = "" })">
                            <i class="mdi mdi-earth text-muted fs-16 align-middle me-1" aria-hidden="true"></i> <span class="align-middle">Beranda Publik</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <form method="post" action="@Url.Action("Logout", "Login", new { area = "" })" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item">
                                <i class="mdi mdi-logout text-muted fs-16 align-middle me-1" aria-hidden="true"></i> <span class="align-middle">Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
