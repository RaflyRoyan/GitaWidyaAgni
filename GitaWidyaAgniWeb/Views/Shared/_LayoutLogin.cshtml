@inject GitaWidyaAgniWeb.Infrastructure.AccessService Access
@{
    var appName = Access.GetAppName();
    // Foto organisasi pertama untuk panel kiri; tanpa foto → emblem logo saja.
    int? photoSeq = null;
    try
    {
        photoSeq = GWALib.Lib.Master.Organization.OrganizationPhoto.GetInfoList().Select(x => (int?)x.SeqPhoto).FirstOrDefault();
    }
    catch
    {
        photoSeq = null;
    }
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] · @appName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Masuk ke sistem @appName" />
    <meta name="theme-color" content="#fbf8f2" />
    <meta name="robots" content="noindex" />
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&display=swap" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/css/landing.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="gwa">
    <div class="gwa-auth">
        <aside class="auth-showcase" aria-hidden="true">
            <a class="gwa-brand" href="@Url.Action("Index", "Landing")" tabindex="-1">
                <img src="@Url.Action("Logo", "Brand")" alt="" width="44" height="44">
                <span><b>Gita Widya Agni</b><small>Marching Band UPN Jatim</small></span>
            </a>

            <div class="auth-stage @(photoSeq == null ? "no-photo" : "")">
                @if (photoSeq != null)
                {
                    <div class="auth-photo"><img src="@Url.Action("OrganizationImage", "Landing", new { id = photoSeq })" alt=""></div>
                    <div class="auth-chip"><i class="ri-music-2-line"></i>Sejak 1990</div>
                }
                <div class="auth-emblem"><img src="@Url.Action("Logo", "Brand")" alt=""></div>
            </div>

            <div class="auth-quote">
                <span class="eyebrow">Ruang Anggota &amp; Pengurus</span>
                <h2>Semangat yang <em>berapi-api</em> dalam belajar musik.</h2>
                <p>Kelola kegiatan, presensi, keuangan, dan prestasi Gita Widya Agni dalam satu tempat.</p>
                <div class="auth-stripe mt-4"><span></span><span></span><span></span></div>
            </div>
        </aside>

        <main class="auth-panel">
            <div class="auth-top">
                <a class="gwa-brand auth-mobile-brand" href="@Url.Action("Index", "Landing")">
                    <img src="@Url.Action("Logo", "Brand")" alt="" width="40" height="40">
                    <span><b>Gita Widya Agni</b><small>Marching Band UPN Jatim</small></span>
                </a>
                <a class="auth-back ms-auto" href="@Url.Action("Index", "Landing")"><i class="ri-arrow-left-line" aria-hidden="true"></i> Beranda</a>
            </div>

            <div class="auth-body">
                <div class="auth-card">
                    @RenderBody()
                </div>
            </div>

            <p class="auth-foot mb-0">&copy; @DateTime.Now.Year @appName · UPN &quot;Veteran&quot; Jawa Timur</p>
        </main>
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
