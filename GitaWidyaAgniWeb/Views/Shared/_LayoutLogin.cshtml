@inject GitaWidyaAgniWeb.Infrastructure.AccessService Access
@{
    var appName = Access.GetAppName();
    // Foto organisasi pertama untuk panel kiri; tanpa foto → emblem logo saja.
    int? photoSeq = null;
    try
    {
        photoSeq = GWALib.Lib.Master.Organization.OrganizationPhoto.GetInfoList().Select(x => (int?)x.SeqPhoto).FirstOrDefault();
    }
    catch
    {
        photoSeq = null;
    }
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] · @appName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Masuk ke sistem @appName" />
    <meta name="theme-color" content="#fbf8f2" />
    <meta name="robots" content="noindex" />
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&display=swap" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/css/landing.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="gwa">
    <div class="gwa-auth">
        <aside class="auth-showcase" aria-hidden="true">
            @* Scene dekoratif (pola login GateSafetySecurity, tema marching band): paranada yang mengalir,
               not balok berjalan di paranada (SMIL), titik ketukan berdenyut. Warna emas/merah api/hijau di atas krem. *@
            <svg class="auth-scene" viewBox="0 0 800 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
                <defs>
                    <path id="gwaStaff" d="M-60,430 C150,330 330,540 540,410 S770,300 880,350" />
                    <path id="gwaStaffLow" d="M-60,880 C170,820 360,960 580,870 S790,800 880,830" />
                    <symbol id="gwaNote" viewBox="0 0 24 40">
                        <ellipse cx="8" cy="33" rx="7" ry="5" transform="rotate(-20 8 33)" />
                        <rect x="13.2" y="4" width="2.2" height="29" />
                        <path d="M15.4,4 C22,9 24,15 19,22 C21,15 19,11 15.4,10 Z" />
                    </symbol>
                    <symbol id="gwaNotes" viewBox="0 0 40 40">
                        <ellipse cx="7" cy="33" rx="7" ry="5" transform="rotate(-20 7 33)" />
                        <ellipse cx="31" cy="29" rx="7" ry="5" transform="rotate(-20 31 29)" />
                        <rect x="12" y="8" width="2.2" height="25" />
                        <rect x="36" y="4" width="2.2" height="25" />
                        <path d="M12,8 L38.2,3 L38.2,9 L12,14 Z" />
                    </symbol>
                </defs>

                @* Paranada utama: 5 garis; garis tengah putus-putus yang mengalir *@
                <g class="auth-staff">
                    <use href="#gwaStaff" y="-28" /><use href="#gwaStaff" y="-14" /><use href="#gwaStaff" />
                    <use href="#gwaStaff" y="14" /><use href="#gwaStaff" y="28" />
                </g>
                <use href="#gwaStaff" class="auth-staff-flow" />
                <g class="auth-staff auth-staff-low">
                    <use href="#gwaStaffLow" y="-14" /><use href="#gwaStaffLow" /><use href="#gwaStaffLow" y="14" />
                </g>
                <use href="#gwaStaffLow" class="auth-staff-flow" />

                @* Titik ketukan *@
                <g>
                    <circle cx="540" cy="410" r="4" fill="#c8202a" /><circle class="auth-beat" cx="540" cy="410" r="9" />
                    <circle cx="150" cy="378" r="3.5" fill="#e8b52a" /><circle class="auth-beat" cx="150" cy="378" r="8" style="animation-delay:.8s" />
                    <circle cx="580" cy="870" r="3.5" fill="#1f7a45" /><circle class="auth-beat" cx="580" cy="870" r="8" style="animation-delay:1.6s" />
                </g>

                @* Not balok berjalan di paranada *@
                <g class="auth-note-ink" fill="#c8202a">
                    <use href="#gwaNote" x="-12" y="-38" width="24" height="40" />
                    <animateMotion dur="24s" repeatCount="indefinite" rotate="0"><mpath href="#gwaStaff" /></animateMotion>
                </g>
                <g fill="#8a6100">
                    <use href="#gwaNotes" x="-20" y="-52" width="40" height="40" />
                    <animateMotion dur="24s" begin="-8s" repeatCount="indefinite" rotate="0"><mpath href="#gwaStaff" /></animateMotion>
                </g>
                <g fill="#1f7a45">
                    <use href="#gwaNote" x="-12" y="-24" width="24" height="40" />
                    <animateMotion dur="24s" begin="-16s" repeatCount="indefinite" rotate="0"><mpath href="#gwaStaff" /></animateMotion>
                </g>
            </svg>

            @* Kepala snare drum (tampak atas) berputar pelan *@
            <svg class="auth-drum" viewBox="0 0 100 100" focusable="false">
                <circle cx="50" cy="50" r="46" fill="none" stroke="#8a6100" stroke-width="1.4" />
                <circle cx="50" cy="50" r="38" fill="none" stroke="#8a6100" stroke-width=".8" stroke-dasharray="1.5 3.5" />
                <circle cx="50" cy="50" r="30" fill="none" stroke="#c8202a" stroke-width="1" />
                @for (var i = 0; i < 8; i++)
                {
                    var a = i * Math.PI / 4;
                    <circle cx="@((50 + 42 * Math.Cos(a)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" cy="@((50 + 42 * Math.Sin(a)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" r="2.6" fill="#e8b52a" />
                }
                <path d="M30 30 L70 70 M70 30 L30 70" stroke="#8a6100" stroke-width="1.2" stroke-linecap="round" opacity=".6" />
            </svg>

            <div class="auth-eq"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

            <a class="gwa-brand" href="@Url.Action("Index", "Landing")" tabindex="-1">
                <img src="@Url.Action("Logo", "Brand")" alt="" width="44" height="44">
                <span><b>Gita Widya Agni</b><small>Marching Band UPN Jatim</small></span>
            </a>

            <div class="auth-stage @(photoSeq == null ? "no-photo" : "")">
                @if (photoSeq != null)
                {
                    <div class="auth-photo"><img src="@Url.Action("OrganizationImage", "Landing", new { id = photoSeq })" alt=""></div>
                    <div class="auth-chip"><i class="ri-music-2-line"></i>Sejak 1990</div>
                }
                <div class="auth-emblem"><img src="@Url.Action("Logo", "Brand")" alt=""></div>
            </div>

            <div class="auth-quote">
                <span class="eyebrow">Ruang Anggota &amp; Pengurus</span>
                <h2>Semangat yang <em>berapi-api</em> dalam belajar musik.</h2>
                <p>Kelola kegiatan, presensi, keuangan, dan prestasi Gita Widya Agni dalam satu tempat.</p>
                <div class="auth-stripe mt-4"><span></span><span></span><span></span></div>
            </div>
        </aside>

        <main class="auth-panel">
            <div class="auth-top">
                <a class="gwa-brand auth-mobile-brand" href="@Url.Action("Index", "Landing")">
                    <img src="@Url.Action("Logo", "Brand")" alt="" width="40" height="40">
                    <span><b>Gita Widya Agni</b><small>Marching Band UPN Jatim</small></span>
                </a>
                <a class="auth-back ms-auto" href="@Url.Action("Index", "Landing")"><i class="ri-arrow-left-line" aria-hidden="true"></i> Beranda</a>
            </div>

            <div class="auth-body">
                <div class="auth-card">
                    @RenderBody()
                </div>
            </div>

            <p class="auth-foot mb-0">&copy; @DateTime.Now.Year @appName · UPN &quot;Veteran&quot; Jawa Timur</p>
        </main>
    </div>
    <script>
        // Hormati "kurangi animasi": hentikan animasi SMIL (not balok di paranada).
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var scene = document.querySelector('.auth-scene');
            if (scene && scene.pauseAnimations) scene.pauseAnimations();
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
