@model GitaWidyaAgniWeb.Models.Formulir.AspirasiVM.List
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Formulir

@(Html.DevExtreme().DataGrid<AspirasiVM.Row>()
    .ID("tblAspirasi")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Aspirasi")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Title).Caption("Judul").CssClass("fw-medium");
        columns.AddFor(m => m.Kategori).Caption("Kategori");
        columns.AddFor(m => m.Pengirim).Caption("Pengirim");
        columns.AddFor(m => m.InsDate).Caption("Dikirim").DataType(GridColumnDataType.DateTime).Format("dd MMM yyyy HH:mm");
        columns.AddFor(m => m.RespondedAt).Caption("Ditanggapi").DataType(GridColumnDataType.DateTime).Format("dd MMM yyyy HH:mm").Visible(false);
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Aspirasi.statusTemplate"));
        columns.AddAction("Aspirasi.actionTemplate");
    })
)
