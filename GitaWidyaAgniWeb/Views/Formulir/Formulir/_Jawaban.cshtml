@model GitaWidyaAgniWeb.Models.Formulir.FormulirVM.Jawaban
@using GWAShared.Enums
@using GitaWidyaAgniWeb.Infrastructure
@* Ringkasan per pertanyaan (jumlah per pilihan, rata-rata skala) + daftar jawaban. Formulir anonim tidak menyimpan identitas. *@

<div class="gwa-mform">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-bar-chart-2-line"></i></span>
        <div><div class="gwa-mform-info-title">@Model.Judul</div></div>
    </div>
    <ul class="nav nav-tabs gwa-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#jwbRingkasan" type="button" role="tab">Ringkasan</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#jwbDaftar" type="button" role="tab">Jawaban (@Model.Respon.Count)</button></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="jwbRingkasan" role="tabpanel">
            @foreach (var q in Model.Ringkasan)
            {
                var total = Math.Max(1, q.Options.Sum(o => o.Count));
                <div class="border rounded p-3 mb-2">
                    <div class="fw-medium">@q.Seq. @q.QuestionText</div>
                    <div class="small text-muted mb-2">@EnumHelper.Text(q.QuestionType) · @q.AnswerCount jawaban @(q.Average.HasValue ? "· rata-rata " + q.Average.Value.ToString("0.00") : "")</div>
                    @foreach (var o in q.Options)
                    {
                        <div class="d-flex align-items-center gap-2 small mb-1">
                            <span style="width:35%" class="text-truncate" title="@o.Option">@o.Option</span>
                            <div class="progress flex-grow-1" style="height:8px" role="img" aria-label="@o.Count jawaban">
                                <div class="progress-bar bg-primary" style="width:@(o.Count * 100 / total)%"></div>
                            </div>
                            <span style="min-width:2.5rem" class="text-end">@o.Count</span>
                        </div>
                    }
                </div>
            }
            @if (Model.Ringkasan.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada pertanyaan.</p>
            }
        </div>
        <div class="tab-pane fade" id="jwbDaftar" role="tabpanel">
            @if (Model.Respon.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada jawaban.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>#</th><th>Pengisi</th><th>Waktu</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Respon.Count; i++)
                            {
                                var r = Model.Respon[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@(r.MemberName ?? r.ApplicantName ?? (Model.Anonim ? "Anonim" : "-"))</td>
                                    <td>@r.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="Formulir.viewResponse('@r.EncDecrKey')">Lihat</button>
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus jawaban" aria-label="Hapus jawaban" onclick="Formulir.removeResponse('@r.EncDecrKey')"><i class="ri-delete-bin-line"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="jawabanDetail" class="mt-3"></div>
            }
        </div>
    </div>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
