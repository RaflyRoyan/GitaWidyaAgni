@model GitaWidyaAgniWeb.Models.Formulir.FormulirVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Formulir";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-survey-line align-bottom me-1"></i> Formulir</h5>
        <p class="gwa-card-intro">Buat formulir evaluasi kegiatan, pendaftaran, atau survei. Susun pertanyaan, lalu buka formulir agar anggota bisa mengisi di Area Anggota. Setelah ada jawaban, pertanyaan terkunci.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Buat Formulir", "Formulir.add()",
            ("btn-outline-success", "ri-list-check-2", "Pertanyaan"),
            ("btn-outline-info", "ri-bar-chart-2-line", "Jawaban & ringkasan"),
            ("btn-outline-primary", "ri-play-circle-line", "Buka"),
            ("btn-outline-secondary", "ri-stop-circle-line", "Tutup"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah"),
            ("btn-outline-danger", "ri-delete-bin-line", "Hapus"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.FormulirUrl = {};
        ['List', 'Add', 'Edit', 'SimpanBaru', 'Update', 'Delete', 'Buka', 'Tutup', 'Pertanyaan', 'SimpanPertanyaan', 'HapusPertanyaan',
            'Jawaban', 'JawabanDetail', 'HapusJawaban', 'BerkasJawaban'].forEach(function (a) {
            window.FormulirUrl[a.charAt(0).toLowerCase() + a.slice(1)] = '@Url.Action("__")'.replace('__', a);
        });
    </script>
    <script src="~/Scripts/Formulir/Formulir.js" asp-append-version="true"></script>
}
