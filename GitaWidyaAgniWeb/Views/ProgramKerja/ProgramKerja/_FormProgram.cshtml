@model GitaWidyaAgniWeb.Models.ProgramKerja.ProgramKerjaVM.AddProgram
@using GitaWidyaAgniWeb.Models.ProgramKerja
@* Form bersama Add & Edit program. Periode tetap setelah dibuat; status lewat tombol di grid. *@

@{
    var editModel = Model as ProgramKerjaVM.EditProgram;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-briefcase-4-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Title</div>
                <div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div>
            </div>
        </div>
    }
    @(Html.DevExtreme().Form<ProgramKerjaVM.NewProgram>()
        .ID("frmProgram")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.DivisionId).Editor(e => e.SelectBox().DataSource(Model.DivisiOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Umum"));
            items.AddSimpleFor(m => m.Term).Editor(e => e.SelectBox().DataSource(Model.JangkaOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.PicMemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.StartDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.EndDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.BudgetAmount).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0"));
            items.AddSimpleFor(m => m.PreviousProgramId).Editor(e => e.SelectBox().DataSource(Model.ProgramOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true).Placeholder("Program baru"));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(100));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="ProgramKerja.save('Program', @(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
