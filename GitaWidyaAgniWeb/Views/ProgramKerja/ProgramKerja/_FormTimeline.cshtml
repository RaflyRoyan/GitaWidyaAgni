@model GitaWidyaAgniWeb.Models.ProgramKerja.ProgramKerjaVM.AddTimeline
@using GitaWidyaAgniWeb.Models.ProgramKerja
@* Form bersama Add & Edit rencana timeline. Tanggal mulai (bila diisi) menentukan tahun & bulan. *@

@{
    var isEdit = Model is ProgramKerjaVM.EditTimeline;
}

<div class="gwa-mform">
    @(Html.DevExtreme().Form<ProgramKerjaVM.NewTimeline>()
        .ID("frmTimeline")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.PlanType).Editor(e => e.SelectBox().DataSource(Model.JenisOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.PlanYear).Editor(e => e.NumberBox().Min(2000).Max(2100).Format("#0").ShowSpinButtons(true));
            items.AddSimpleFor(m => m.PlanMonth).Editor(e => e.SelectBox().DataSource(Model.BulanOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.StartDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.EndDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.PicMemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.ProgramId).ColSpan(3).Editor(e => e.SelectBox().DataSource(Model.ProgramOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(80));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="ProgramKerja.save('Timeline', @(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
