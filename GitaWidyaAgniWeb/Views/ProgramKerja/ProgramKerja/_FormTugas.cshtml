@model GitaWidyaAgniWeb.Models.ProgramKerja.ProgramKerjaVM.AddTugas
@using GitaWidyaAgniWeb.Models.ProgramKerja
@* Form bersama Add & Edit tugas. Tugas program memakai periode program; tugas umum (tanpa program) wajib periode. *@

@{
    var editModel = Model as ProgramKerjaVM.EditTugas;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-task-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Title</div>
                <div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div>
            </div>
        </div>
    }
    @(Html.DevExtreme().Form<ProgramKerjaVM.NewTugas>()
        .ID("frmTugas")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.ProgramId).Editor(e => e.SelectBox().DataSource(Model.ProgramOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true).Placeholder("Tugas umum"));
                items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            }
            items.AddSimpleFor(m => m.DivisionId).Editor(e => e.SelectBox().DataSource(Model.DivisiOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.ResponsibleMemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.Priority).Editor(e => e.SelectBox().DataSource(Model.PrioritasOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.IsMilestone).Editor(e => e.SelectBox().DataSource(Model.MilestoneOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.StartDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.DueDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(90));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="ProgramKerja.save('Tugas', @(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
