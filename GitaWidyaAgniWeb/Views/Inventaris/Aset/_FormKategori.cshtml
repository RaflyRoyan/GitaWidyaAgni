@model GitaWidyaAgniWeb.Models.Inventaris.AsetVM.AddKategori
@using GitaWidyaAgniWeb.Models.Inventaris
@{ var isEdit = Model is AsetVM.EditKategori; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<AsetVM.NewKategori>()
        .ID("frmKategori")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextBox().MaxLength(255));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Aset.save('Kategori', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
