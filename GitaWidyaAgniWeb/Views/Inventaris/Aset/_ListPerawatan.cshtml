@model GitaWidyaAgniWeb.Models.Inventaris.AsetVM.ListPerawatan
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Inventaris

@(Html.DevExtreme().DataGrid<AsetVM.PerawatanRow>()
    .ID("tblPerawatan")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Perawatan Aset")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.MaintenanceDate).Caption("Tanggal").DataType(GridColumnDataType.Date).Format("dd MMM yyyy");
        columns.AddFor(m => m.Aset).Caption("Aset").CssClass("fw-medium");
        columns.AddFor(m => m.UnitCode).Caption("Unit").CellTemplate(new JS("AppUI.codeTemplate"));
        columns.AddFor(m => m.Description).Caption("Uraian");
        columns.AddFor(m => m.Vendor).Caption("Vendor");
        columns.AddFor(m => m.Cost).Caption("Biaya").Format("#,##0");
        columns.AddFor(m => m.Dibayar).Caption("Dibayar").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Aset.maintenanceStatusTemplate"));
        columns.AddAction("Aset.maintenanceActionTemplate");
    })
)
