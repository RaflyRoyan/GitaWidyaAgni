@model GitaWidyaAgniWeb.Models.Inventaris.AsetVM.AddPerawatan
@using GitaWidyaAgniWeb.Models.Inventaris
@{
    var editModel = Model as AsetVM.EditPerawatan;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-tools-line"></i></span>
            <div><div class="gwa-mform-info-title">@editModel!.Aset</div></div>
        </div>
    }
    @(Html.DevExtreme().Form<AsetVM.NewPerawatan>()
        .ID("frmPerawatan")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.AssetId).Editor(e => e.SelectBox().DataSource(Model.AsetOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true));
                items.AddSimpleFor(m => m.UnitCode).Editor(e => e.TextBox().MaxLength(20).Placeholder("mis. HT001").InputAttr(new { style = "text-transform:uppercase" }));
            }
            items.AddSimpleFor(m => m.MaintenanceDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.Cost).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0"));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextBox().MaxLength(255));
            items.AddSimpleFor(m => m.Vendor).ColSpan(2).Editor(e => e.TextBox().MaxLength(150));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Aset.save('Perawatan', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
