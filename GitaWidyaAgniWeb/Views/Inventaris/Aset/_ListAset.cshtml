@model GitaWidyaAgniWeb.Models.Inventaris.AsetVM.ListAset
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Inventaris

@(Html.DevExtreme().DataGrid<AsetVM.AsetRow>()
    .ID("tblAset")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Aset Inventaris")
    .OnRowPrepared("AppUI.inactiveRowPrepared")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.AssetCode).Caption("Kode").CellTemplate(new JS("AppUI.codeTemplate"));
        columns.AddFor(m => m.Name).Caption("Aset").CellTemplate(new JS("Aset.nameTemplate"));
        columns.AddFor(m => m.Kategori).Caption("Kategori");
        columns.AddFor(m => m.Quantity).Caption("Jumlah").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Aset.qtyTemplate"));
        columns.AddFor(m => m.PerUnit).Caption("Per Unit").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddFor(m => m.Location).Caption("Lokasi");
        columns.AddFor(m => m.Kondisi).Caption("Kondisi").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Aset.conditionTemplate"));
        columns.AddFor(m => m.Sumber).Caption("Sumber").Visible(false);
        columns.AddFor(m => m.AcquisitionCost).Caption("Nilai").Format("#,##0").Visible(false);
        columns.AddFor(m => m.RentalFeePerDay).Caption("Sewa/Hari").Format("#,##0").Visible(false);
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Aset.statusTemplate"));
        columns.AddAction("Aset.assetActionTemplate");
    })
)
