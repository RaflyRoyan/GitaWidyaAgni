@model GitaWidyaAgniWeb.Models.Inventaris.PeminjamanVM.Checkout
@* Serahkan semua item sekaligus. Aset per unit: pilih / scan tepat sejumlah kode unit Tersedia. Aset per jumlah: kondisi saat diserahkan. *@

<div class="gwa-mform" id="pinjamCheckout" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-hand-heart-line"></i></span>
        <div><div class="gwa-mform-info-title">@Model.Judul</div></div>
    </div>
    @foreach (var i in Model.Items)
    {
        <div class="border rounded p-3 mb-2 checkout-item" data-id="@i.Id" data-unit="@(i.PerUnit ? "1" : "0")" data-qty="@i.Quantity">
            <div class="fw-semibold mb-2">@i.Aset <span class="text-muted fw-normal">× @i.Quantity</span></div>
            @if (i.PerUnit)
            {
                <label class="form-label small mb-1" for="unit@(i.Id)">Kode unit (@i.Quantity) — ketik / scan lalu Enter</label>
                @(Html.DevExtreme().TagBox().ID("unit" + i.Id).DataSource(i.UnitTersedia).AcceptCustomValue(true).SearchEnabled(true).Placeholder("Pilih / scan kode unit..."))
            }
            else
            {
                <label class="form-label small mb-1" for="kondisi@(i.Id)">Kondisi saat diserahkan</label>
                <select id="kondisi@(i.Id)" class="form-select">
                    @foreach (var k in Model.KondisiOpsi)
                    {
                        <option value="@k.Value">@k.Text</option>
                    }
                </select>
            }
        </div>
    }
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Peminjaman.saveCheckout()"><i class="ri-check-line align-bottom me-1"></i> Serahkan</button>
    </div>
</div>
