@model GitaWidyaAgniWeb.Models.Inventaris.PeminjamanVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Peminjaman Alat";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-swap-box-line align-bottom me-1"></i> Peminjaman Alat</h5>
        <p class="gwa-card-intro">Alur: Menunggu → Disetujui → serahkan barang (scan kode unit) → kembali per item / per unit. Sewa dihitung per hari untuk skema Tarif Tetap; denda telat dihitung saat barang kembali.</p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Catat Peminjaman", "Peminjaman.add()",
            ("btn-outline-info", "ri-file-list-3-line", "Detail, item, pengembalian, pembayaran"),
            ("btn-outline-success", "ri-check-double-line", "Setujui"),
            ("btn-outline-primary", "ri-hand-heart-line", "Serahkan barang (checkout)"),
            ("btn-outline-dark", "ri-money-dollar-circle-line", "Catat pembayaran"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah (Menunggu)"),
            ("btn-outline-secondary", "ri-close-circle-line", "Tolak / batalkan"),
            ("btn-outline-danger", "ri-delete-bin-line", "Hapus"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.PeminjamanUrl = {};
        ['List', 'Add', 'Edit', 'SimpanBaru', 'Update', 'Delete', 'Setujui', 'Tolak', 'Batal', 'Detail', 'TambahItem', 'HapusItem', 'Checkout', 'SimpanCheckout',
            'KembaliJumlah', 'KembaliUnit', 'Bayar', 'SimpanBayar', 'BatalBayar', 'BebasDenda'].forEach(function (a) {
            window.PeminjamanUrl[a.charAt(0).toLowerCase() + a.slice(1)] = '@Url.Action("__")'.replace('__', a);
        });
    </script>
    <script src="~/Scripts/Inventaris/Peminjaman.js" asp-append-version="true"></script>
}
