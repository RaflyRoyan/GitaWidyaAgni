@model GitaWidyaAgniWeb.Models.EVoting.EVotingVM.Add
@using GitaWidyaAgniWeb.Models.EVoting
@* Periode dan jadwal hanya bisa diubah saat Draft / Pendaftaran; saat Dibuka hanya waktu selesai yang bisa diperpanjang. *@
@{
    var editModel = Model as EVotingVM.Edit;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-checkbox-multiple-line"></i></span>
            <div><div class="gwa-mform-info-title">@Model.Row.Title</div><div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div></div>
        </div>
    }
    @(Html.DevExtreme().Form<EVotingVM.NewRow>()
        .ID("frmEVoting")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200).Placeholder("mis. Pemilihan Ketua Umum 2027"));
            items.AddSimpleFor(m => m.PeriodId).ColSpan(2).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).ReadOnly(Model.JadwalTerkunci));
            items.AddSimpleFor(m => m.StartAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ReadOnly(Model.JadwalTerkunci));
            items.AddSimpleFor(m => m.EndAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ReadOnly(Model.JadwalTerkunci && !Model.BolehPerpanjang));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(90));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="EVoting.save(@(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
