@model GitaWidyaAgniWeb.Models.EVoting.EVotingVM.Kelola
@using GWAShared.Enums
@using GitaWidyaAgniWeb.Infrastructure
@*
    Kandidat diubah hanya saat Draft / Pendaftaran. Pemilih ditambah sampai pemungutan Dibuka; pemilih yang sudah memilih tidak bisa diubah.
    Kotak suara hanya menampilkan nomor referensi surat suara (tanpa pilihan), untuk dicocokkan dengan bukti milik pemilih.
*@
@{
    var terverifikasi = Model.Kandidat.Count(k => k.Status == CandidateStatus.Verified);
    var berhak = Model.Pemilih.Count(p => p.EligibilityStatus == VoterEligibility.Eligible);
    var sudah = Model.Pemilih.Count(p => p.HasVoted);
}

<div class="gwa-mform" id="kelolaEVoting" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-checkbox-multiple-line"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.Judul</div>
            <div class="gwa-mform-info-meta"><span>@terverifikasi kandidat terverifikasi · @berhak pemilih berhak · @sudah sudah memilih · @Model.JumlahSuara suara masuk</span></div>
        </div>
    </div>

    <ul class="nav nav-tabs gwa-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#evKandidat" type="button" role="tab">Kandidat (@Model.Kandidat.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#evPemilih" type="button" role="tab">Pemilih (@Model.Pemilih.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#evHasil" type="button" role="tab">Hasil &amp; Kotak Suara</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#evAudit" type="button" role="tab">Log Audit</button></li>
    </ul>

    <div class="tab-content">
        @* ---------- Kandidat ---------- *@
        <div class="tab-pane fade show active" id="evKandidat" role="tabpanel">
            @if (Model.BisaUbahKandidat)
            {
                <div class="gwa-mform-add flex-column align-items-stretch">
                    <input type="hidden" id="kdKey" />
                    <div class="row g-2 w-100">
                        <div class="col-md-6" id="kdAnggotaWrap">
                            <label class="form-label small mb-1" for="kdAnggota">Anggota</label>
                            @(Html.DevExtreme().SelectBox().ID("kdAnggota").DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih anggota..."))
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1" for="kdNomor">No. Urut</label>
                            <input id="kdNomor" type="number" min="1" class="form-control" placeholder="otomatis" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">Foto</label>
                            @(Html.DevExtreme().FileUploader().ID("kdFoto").UploadMode(FileUploadMode.UseForm).Multiple(false).Accept("image/*")
                                .MaxFileSize(5 * 1024 * 1024).SelectButtonText("Pilih foto").LabelText(""))
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="kdVisi">Visi</label>
                            <textarea id="kdVisi" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1" for="kdMisi">Misi</label>
                            <textarea id="kdMisi" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <label class="form-check-label me-auto" id="kdHapusFotoWrap" hidden><input type="checkbox" id="kdHapusFoto" class="form-check-input me-1" /> Hapus foto</label>
                            <button type="button" class="btn btn-light" id="kdBatal" hidden onclick="EVoting.resetCandidate()">Batal ubah</button>
                            <button type="button" class="btn btn-outline-primary" onclick="EVoting.saveCandidate()"><i class="ri-save-3-line align-bottom me-1"></i> <span id="kdSaveText">Daftarkan Kandidat</span></button>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Kandidat.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada kandidat.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var k in Model.Kandidat)
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 d-flex gap-3 @(k.Status == CandidateStatus.Rejected || k.Status == CandidateStatus.Withdrawn ? "opacity-50" : "")">
                                <img src="@Url.Action("FotoKandidat", new { key = k.EncDecrKey })" alt="" width="72" height="72" style="object-fit:cover;border-radius:8px;background:#f3ede2"
                                     onerror="this.style.visibility='hidden'" />
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary">@(k.CandidateNumber?.ToString() ?? "-")</span>
                                        <span class="fw-semibold">@k.MemberName</span>
                                        <span class="badge badge-soft-secondary ms-auto">@EnumHelper.Text(k.Status)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(k.Vision))
                                    {
                                        <div class="small mt-1"><b>Visi:</b> <span style="white-space:pre-line">@k.Vision</span></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(k.Mission))
                                    {
                                        <div class="small"><b>Misi:</b> <span style="white-space:pre-line">@k.Mission</span></div>
                                    }
                                    @if (Model.BisaUbahKandidat)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @if (k.Status == CandidateStatus.Registered || k.Status == CandidateStatus.Rejected)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" onclick="EVoting.candidateAction('verifikasiKandidat','@k.EncDecrKey')">Verifikasi</button>
                                            }
                                            @if (k.Status == CandidateStatus.Registered)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="EVoting.candidateAction('tolakKandidat','@k.EncDecrKey')">Tolak</button>
                                            }
                                            @if (k.Status == CandidateStatus.Registered || k.Status == CandidateStatus.Verified)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="EVoting.candidateAction('mundurKandidat','@k.EncDecrKey')">Mundur</button>
                                                <button type="button" class="btn btn-sm btn-outline-warning" data-key="@k.EncDecrKey" data-nomor="@k.CandidateNumber" data-visi="@k.Vision" data-misi="@k.Mission" onclick="EVoting.editCandidate(this)">Ubah</button>
                                            }
                                            <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus kandidat" aria-label="Hapus kandidat" onclick="EVoting.candidateAction('hapusKandidat','@k.EncDecrKey')"><i class="ri-delete-bin-line"></i></button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ---------- Pemilih ---------- *@
        <div class="tab-pane fade" id="evPemilih" role="tabpanel">
            @if (Model.BisaUbahPemilih)
            {
                <div class="gwa-mform-add flex-column align-items-stretch">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <span class="small fw-semibold">Tambah semua anggota aktif bertipe:</span>
                        @foreach (var t in Model.TipeAnggotaOpsi)
                        {
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1 ev-tipe" value="@t.Value" checked="@(t.Value != (int)MemberType.Alumni)" /> @t.Text</label>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary ms-auto" onclick="EVoting.generateVoters()"><i class="ri-group-line me-1"></i> Tambahkan</button>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <div style="min-width:280px;flex:1">
                            @(Html.DevExtreme().TagBox().ID("evAnggota").DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowSelectionControls(true).Placeholder("Atau pilih anggota tertentu..."))
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="EVoting.addVoters()"><i class="ri-user-add-line me-1"></i> Tambahkan</button>
                    </div>
                </div>
            }
            @if (Model.Pemilih.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada pemilih.</p>
            }
            else
            {
                <div class="table-responsive" style="max-height:420px">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Anggota</th><th>NIM</th><th>Hak Pilih</th><th>Sudah Memilih</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Pemilih)
                            {
                                var eligible = p.EligibilityStatus == VoterEligibility.Eligible;
                                <tr class="@(eligible ? "" : "text-muted")">
                                    <td>@p.MemberName</td>
                                    <td>@p.Nim</td>
                                    <td>@EnumHelper.Text(p.EligibilityStatus)</td>
                                    <td>@(p.HasVoted ? "Ya · " + p.VotedAt?.ToString("dd MMM HH:mm") : "-")</td>
                                    <td class="text-end text-nowrap">
                                        @if (Model.BisaUbahPemilih && !p.HasVoted)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="EVoting.setEligibility('@p.EncDecrKey', @(eligible ? (int)VoterEligibility.Ineligible : (int)VoterEligibility.Eligible))">@(eligible ? "Cabut hak" : "Beri hak")</button>
                                            @if (Model.BisaUbahKandidat)
                                            {
                                                <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus pemilih" aria-label="Hapus pemilih" onclick="EVoting.removeVoter('@p.EncDecrKey')"><i class="ri-delete-bin-line"></i></button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ---------- Hasil & kotak suara ---------- *@
        <div class="tab-pane fade" id="evHasil" role="tabpanel">
            @if (Model.Status != ElectionStatus.Finalized)
            {
                <p class="gwa-mform-note">Hasil dihitung saat Finalisasi (setelah pemungutan ditutup). Saat ini @Model.JumlahSuara suara masuk.</p>
            }
            else
            {
                var maxVote = Math.Max(1, Model.Hasil.Count == 0 ? 1 : Model.Hasil.Max(h => h.VoteCount));
                <ol class="list-unstyled mb-3">
                    @foreach (var h in Model.Hasil)
                    {
                        <li class="d-flex align-items-center gap-2 py-1">
                            <span class="badge @(h.IsWinner == ElectionOutcome.Winner ? "bg-warning text-dark" : "bg-light text-dark")" style="min-width:2rem">@h.RankNo</span>
                            <span style="width:35%">@h.CandidateNumber. @h.MemberName @if (h.IsWinner == ElectionOutcome.Winner) {<i class="ri-trophy-fill text-warning" title="Pemenang"></i>}</span>
                            <div class="progress flex-grow-1" style="height:10px" role="img" aria-label="@h.VoteCount suara">
                                <div class="progress-bar bg-primary" style="width:@(h.VoteCount * 100 / maxVote)%"></div>
                            </div>
                            <span class="text-end" style="min-width:6rem">@h.VoteCount (@h.VotePercentage.ToString("0.##")%)</span>
                        </li>
                    }
                </ol>
            }
            <div class="gwa-mform-section"><span class="gwa-mform-section-title">Kotak suara</span><span class="gwa-mform-section-hint">referensi surat suara, tanpa pilihan</span></div>
            @if (Model.KotakSuara.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada suara.</p>
            }
            else
            {
                <div class="small font-monospace border rounded p-2" style="max-height:220px;overflow:auto">
                    @foreach (var v in Model.KotakSuara)
                    {
                        <div>@v.VotedDate.ToString("dd MMM yyyy") · @v.BallotReference</div>
                    }
                </div>
            }
        </div>

        @* ---------- Audit ---------- *@
        <div class="tab-pane fade" id="evAudit" role="tabpanel">
            @if (Model.Audit.Count == 0)
            {
                <p class="text-muted mb-0">Belum ada log.</p>
            }
            else
            {
                <div class="table-responsive" style="max-height:420px">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Waktu</th><th>Peristiwa</th><th>Oleh</th><th>Keterangan</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Audit)
                            {
                                <tr><td class="text-nowrap">@e.InsDate.ToString("dd MMM yyyy HH:mm")</td><td><span class="gwa-code">@e.EventType</span></td><td>@e.ActorName</td><td>@e.Description</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
