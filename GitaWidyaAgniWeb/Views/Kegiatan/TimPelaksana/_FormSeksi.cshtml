@model GitaWidyaAgniWeb.Models.Kegiatan.TimPelaksanaVM.AddSeksi
@using GitaWidyaAgniWeb.Models.Kegiatan
@{ var isEdit = Model is TimPelaksanaVM.EditSeksi; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<TimPelaksanaVM.NewSeksi>()
        .ID("frmSeksi")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).ColSpan(2).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Acara, Konsumsi, Perlengkapan"));
            items.AddSimpleFor(m => m.SeqNo).Editor(e => e.NumberBox().Min(0).Max(999).ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(70).MaxLength(255));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="TimPelaksana.save('Seksi', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
