@model GitaWidyaAgniWeb.Models.Kegiatan.TimPelaksanaVM.AddRundown
@using GitaWidyaAgniWeb.Models.Kegiatan
@{ var isEdit = Model is TimPelaksanaVM.EditRundown; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<TimPelaksanaVM.NewRundown>()
        .ID("frmRundown")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.RundownDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.StartTime).Editor(e => e.DateBox().Type(DateBoxType.Time).DisplayFormat("HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
            items.AddSimpleFor(m => m.EndTime).Editor(e => e.DateBox().Type(DateBoxType.Time).DisplayFormat("HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ShowClearButton(true));
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.SeqNo).Editor(e => e.NumberBox().Min(0).Max(999).ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.LocationName).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.SectionId).Editor(e => e.SelectBox().DataSource(Model.SeksiOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.PicMemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(70));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="TimPelaksana.save('Rundown', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
