@model GitaWidyaAgniWeb.Models.Kegiatan.TimPelaksanaVM.AddTemplate
@using GitaWidyaAgniWeb.Models.Kegiatan
@{ var isEdit = Model is TimPelaksanaVM.EditTemplate; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<TimPelaksanaVM.NewTemplate>()
        .ID("frmTemplate")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).ColSpan(2).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.ActivityType).Editor(e => e.SelectBox().DataSource(Model.JenisOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Semua jenis"));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(70).MaxLength(255));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="TimPelaksana.save('Template', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
