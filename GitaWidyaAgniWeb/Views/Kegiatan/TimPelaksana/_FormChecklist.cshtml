@model GitaWidyaAgniWeb.Models.Kegiatan.TimPelaksanaVM.AddChecklist
@using GitaWidyaAgniWeb.Models.Kegiatan
@{ var isEdit = Model is TimPelaksanaVM.EditChecklist; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<TimPelaksanaVM.NewChecklist>()
        .ID("frmChecklist")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.SectionId).Editor(e => e.SelectBox().DataSource(Model.SeksiOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.PicMemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.DueDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.Priority).Editor(e => e.SelectBox().DataSource(Model.PrioritasOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.IsMilestone).Editor(e => e.SelectBox().DataSource(Model.MilestoneOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(70));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="TimPelaksana.save('Checklist', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
