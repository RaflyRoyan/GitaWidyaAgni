@model GitaWidyaAgniWeb.Models.Kegiatan.PresensiVM.AddSesi
@using GitaWidyaAgniWeb.Models.Kegiatan
@* Form bersama Add & Edit sesi. Kegiatan tetap setelah dibuat. Titik + radius kosong = tanpa cek lokasi. *@
@{
    var editModel = Model as PresensiVM.EditSesi;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-qr-code-line"></i></span>
            <div><div class="gwa-mform-info-title">@editModel!.Kegiatan</div></div>
        </div>
    }
    @(Html.DevExtreme().Form<PresensiVM.NewSesi>()
        .ID("frmSesi")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.ActivityId).ColSpan(3).Editor(e => e.SelectBox().DataSource(Model.KegiatanOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih kegiatan..."));
            }
            items.AddSimpleFor(m => m.Name).ColSpan(2).Editor(e => e.TextBox().MaxLength(150).Placeholder("mis. Latihan Rutin Sabtu"));
            items.AddSimpleFor(m => m.LateToleranceMinute).Editor(e => e.NumberBox().Min(0).Max(240).ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.OpenAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
            items.AddSimpleFor(m => m.CloseAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
            items.AddSimpleFor(m => m.Location).Editor(e => e.TextBox().MaxLength(255));
            items.AddSimpleFor(m => m.Latitude).Editor(e => e.NumberBox().Format("#0.0000000").Step(0));
            items.AddSimpleFor(m => m.Longitude).Editor(e => e.NumberBox().Format("#0.0000000").Step(0));
            items.AddSimpleFor(m => m.RadiusMeter).Editor(e => e.NumberBox().Min(10).Format("#0"));
        })
    )
    <p class="gwa-mform-note">Isi titik lokasi + radius untuk mewajibkan anggota berada di sekitar lokasi saat presensi.</p>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Presensi.save('Sesi', @(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
