@model GitaWidyaAgniWeb.Models.Kegiatan.PresensiVM.Statistik
@using GWALib.Lib.Transaksi.Presensi
@using System.Globalization
@* Isi tab Statistik (dimuat ulang Presensi.js saat saringan berubah): ringkasan, grafik tren bulanan + per section (dxChart, data di
   #statistikData), dan tabel anggota berkehadiran di bawah AttendanceSession.LOW_PERCENT. *@
@{
    var d = Model.Data;
    var id = CultureInfo.GetCultureInfo("id-ID");
    var batas = AttendanceSession.LOW_PERCENT;
    var data = new
    {
        Batas = batas,
        Months = d.Months.Select(m => new
        {
            Bulan = new DateTime(m.Year, m.Month, 1).ToString("MMM yy", id),
            m.Hadir, m.Terlambat, m.Izin, m.Sakit, m.Alpa, m.Sessions,
            Persen = m.Sessions == 0 ? (decimal?)null : m.Percent
        }),
        Sections = d.Sections.Select(s => new { s.Name, s.Members, s.Sessions, Persen = s.Percent })
    };
    string Warna(decimal p) => p < batas ? "text-danger" : p < 90 ? "text-warning" : "text-success";
}

<div id="presensiStatistik">
    <p class="text-muted small mb-3">
        @d.From.ToString("d MMM yyyy", id) – @d.To.ToString("d MMM yyyy", id) · hanya sesi yang sudah ditutup.
        @if (Model.MemberId != null)
        {
            <span class="badge bg-primary-subtle text-primary ms-1">Anggota: @(Model.MemberName ?? "belum ada catatan")</span>
        }
    </p>

    <div class="row g-2 mb-3 text-center">
        <div class="col-6 col-md"><div class="border rounded p-2"><div class="fs-4 fw-bold @(d.Sessions == 0 ? "" : Warna(d.Percent))">@(d.Sessions == 0 ? "–" : d.Percent.ToString("0.#", id) + "%")</div><div class="small text-muted">Kehadiran</div></div></div>
        <div class="col-6 col-md"><div class="border rounded p-2"><div class="fs-4 fw-bold">@d.Sessions</div><div class="small text-muted">Catatan presensi</div></div></div>
        <div class="col-4 col-md"><div class="border rounded p-2"><div class="fs-4 fw-bold text-success">@(d.Hadir + d.Terlambat)</div><div class="small text-muted">Hadir (@d.Terlambat telat)</div></div></div>
        <div class="col-4 col-md"><div class="border rounded p-2"><div class="fs-4 fw-bold text-info">@(d.Izin + d.Sakit)</div><div class="small text-muted">Izin / Sakit</div></div></div>
        <div class="col-4 col-md"><div class="border rounded p-2"><div class="fs-4 fw-bold text-danger">@d.Alpa</div><div class="small text-muted">Alpa</div></div></div>
    </div>

    @if (d.Sessions == 0)
    {
        <div class="text-center text-muted py-5 border rounded">
            <i class="ri-bar-chart-2-line fs-1 d-block mb-2" aria-hidden="true"></i>
            Belum ada sesi yang ditutup pada rentang dan saringan ini.
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="@(Model.MemberId == null ? "col-xl-8" : "col-12")">
                <div class="border rounded p-2 h-100">
                    <div class="fw-semibold mb-1"><i class="ri-line-chart-line me-1"></i> Tren per bulan</div>
                    <div id="chartStatBulan" style="height:320px" role="img" aria-label="Grafik jumlah hadir, terlambat, izin, sakit, alpa dan persen kehadiran per bulan"></div>
                </div>
            </div>
            @if (Model.MemberId == null)
            {
                <div class="col-xl-4">
                    <div class="border rounded p-2 h-100">
                        <div class="fw-semibold mb-1"><i class="ri-group-line me-1"></i> Kehadiran per section</div>
                        <div id="chartStatSection" style="height:320px" role="img" aria-label="Grafik persen kehadiran per section"></div>
                    </div>
                </div>
            }
        </div>

        @if (Model.MemberId == null)
        {
            <div class="mt-3">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="fw-semibold"><i class="ri-error-warning-line text-danger me-1"></i> Kehadiran di bawah @batas%</span>
                    <span class="small text-muted">minimal @AttendanceSession.LOW_MIN_SESSIONS catatan · klik nama untuk melihat tren anggota</span>
                    <span class="badge bg-danger-subtle text-danger ms-auto">@d.LowMembers.Count anggota</span>
                </div>
                @if (d.LowMembers.Count == 0)
                {
                    <div class="alert alert-success mb-0"><i class="ri-checkbox-circle-line me-1"></i> Semua anggota hadir minimal @batas%.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Anggota</th><th>Section</th><th class="text-end">Sesi</th><th class="text-end">Hadir</th><th class="text-end">Izin/Sakit</th><th class="text-end">Alpa</th><th class="text-end">% Hadir</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in d.LowMembers)
                                {
                                    <tr>
                                        <td>
                                            <button type="button" class="btn btn-link p-0 text-start" data-anggota="@r.MemberId">@r.Name</button>
                                            @if (!string.IsNullOrEmpty(r.MemberNumber))
                                            {
                                                <div class="small text-muted">@r.MemberNumber</div>
                                            }
                                        </td>
                                        <td>@(r.Section ?? "–")</td>
                                        <td class="text-end">@r.Sessions</td>
                                        <td class="text-end">@(r.Hadir + r.Terlambat)</td>
                                        <td class="text-end">@(r.Izin + r.Sakit)</td>
                                        <td class="text-end fw-semibold text-danger">@r.Alpa</td>
                                        <td class="text-end fw-bold text-danger">@r.Percent.ToString("0.#", id)%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
    <script type="application/json" id="statistikData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(data))</script>
</div>
