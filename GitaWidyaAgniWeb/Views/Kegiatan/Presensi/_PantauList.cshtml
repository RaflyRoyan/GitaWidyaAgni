@model GitaWidyaAgniWeb.Models.Kegiatan.PresensiVM.Pantau
@using GWAShared.Enums
@using GitaWidyaAgniWeb.Infrastructure
@{
    var d = Model.Data;
    string Kelompok(AttendanceStatus? s) => s == null ? "belum" : s == AttendanceStatus.Hadir || s == AttendanceStatus.Terlambat ? "hadir" : "lain";
    string Badge(AttendanceStatus? s) => s switch
    {
        AttendanceStatus.Hadir => "badge-soft-success",
        AttendanceStatus.Terlambat => "badge-soft-warning",
        AttendanceStatus.Alpa => "badge-soft-danger",
        null => "badge-soft-secondary",
        _ => "badge-soft-info"
    };
}

<div class="gwa-mform-info">
    <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-radar-line"></i></span>
    <div>
        <div class="gwa-mform-info-title">@d.Name</div>
        <div class="gwa-mform-info-meta">
            <span>@d.Activity</span>
            <span>@d.OpenAt.ToString("dd MMM yyyy HH:mm") – @d.CloseAt.ToString("HH:mm")</span>
            <span>@EnumHelper.Text(d.Status) · @EnumHelper.Text(d.Mode)</span>
        </div>
    </div>
</div>

<div class="row g-2 mb-3 text-center" id="pantauRingkas" data-waktu="@d.GeneratedAt.ToString("HH:mm:ss")">
    <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-bold">@d.Rows.Count</div><div class="small text-muted">Sasaran</div></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-bold text-success">@d.Present</div><div class="small text-muted">Hadir (@d.Late telat)</div></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-bold text-secondary">@d.NotYet</div><div class="small text-muted">Belum</div></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-bold text-info">@d.Excused</div><div class="small text-muted">Izin / Sakit</div></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-bold text-danger">@d.Absent</div><div class="small text-muted">Alpa</div></div></div>
</div>

<div class="table-responsive" style="max-height:55vh">
    <table class="table table-sm align-middle mb-0">
        <thead class="table-light" style="position:sticky;top:0">
            <tr><th>Anggota</th><th>Section</th><th class="text-center">Status</th><th class="text-center">Masuk</th><th class="text-center">Keluar</th><th class="text-end">Jarak</th><th></th></tr>
        </thead>
        <tbody>
            @if (d.Rows.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-3">Tidak ada anggota sasaran.</td></tr>
            }
            @foreach (var r in d.Rows)
            {
                var luar = r.Distance != null && d.RadiusMeter != null && r.Distance > d.RadiusMeter;
                <tr data-kelompok="@Kelompok(r.Status)">
                    <td>
                        <div class="fw-medium">@r.Name</div>
                        <div class="small text-muted">@(r.MemberNumber ?? "-")@(r.Expected ? "" : " · di luar sasaran")</div>
                    </td>
                    <td>@(r.Section ?? "-")</td>
                    <td class="text-center"><span class="badge @Badge(r.Status)">@(r.Status == null ? "Belum" : EnumHelper.Text(r.Status.Value))</span></td>
                    <td class="text-center">@(r.CheckInAt?.ToString("HH:mm") ?? "-")</td>
                    <td class="text-center">@(r.CheckOutAt?.ToString("HH:mm") ?? "-")</td>
                    <td class="text-end @(luar ? "text-danger fw-semibold" : "")">@(r.Distance == null ? "-" : r.Distance + " m")</td>
                    <td class="text-end text-nowrap">
                        @if (r.CheckInAt != null && r.RecordKey != null)
                        {
                            <a class="btn btn-sm btn-icon btn-outline-info" href="@Url.Action("Foto", new { key = r.RecordKey })" target="_blank" rel="noopener" title="Foto masuk" aria-label="Foto masuk @r.Name"><i class="ri-camera-line"></i></a>
                        }
                        @if (r.CheckOutAt != null && r.RecordKey != null)
                        {
                            <a class="btn btn-sm btn-icon btn-outline-info" href="@Url.Action("Foto", new { key = r.RecordKey, keluar = true })" target="_blank" rel="noopener" title="Foto keluar" aria-label="Foto keluar @r.Name"><i class="ri-camera-switch-line"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
