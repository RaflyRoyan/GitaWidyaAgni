@model GitaWidyaAgniWeb.Models.Kegiatan.PresensiVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Presensi";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-qr-scan-2-line align-bottom me-1"></i> Presensi Kegiatan</h5>
        <p class="gwa-card-intro">Sesi dibuat otomatis dari jadwal rutin (dan dari kegiatan non-rutin yang punya koordinat), dibuka otomatis 30 menit sebelum mulai, dan ditutup otomatis setelah selesai: anggota wajib hadir yang belum presensi dicatat Alpa. Mode <b>Tanpa QR</b>: anggota check-in langsung dari Area Anggota › Presensi (lokasi + selfie). Mode <b>Wajib Scan QR</b> (mis. rapat): tampilkan QR sesi untuk dipindai.</p>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs gwa-tabs mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabSesi" data-tab="Sesi" type="button" role="tab"><i class="ri-qr-code-line me-1"></i>Sesi</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabJadwal" data-tab="Jadwal" type="button" role="tab"><i class="ri-calendar-schedule-line me-1"></i>Jadwal Rutin</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabNotulen" data-tab="Notulen" type="button" role="tab"><i class="ri-file-text-line me-1"></i>Notulen</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStatistik" data-tab="Statistik" type="button" role="tab"><i class="ri-bar-chart-box-line me-1"></i>Statistik</button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabSesi" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Sesi", "Presensi.add(\"Sesi\")",
                    ("btn-outline-primary", "ri-qr-code-line", "Buka sesi / tampilkan QR"),
                    ("btn-outline-info", "ri-radar-line", "Pantau langsung"),
                    ("btn-outline-success", "ri-list-check-3", "Rekap & presensi manual"),
                    ("btn-outline-secondary", "ri-lock-line", "Tutup sesi"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah sesi"),
                    ("btn-outline-danger", "ri-close-circle-line", "Batalkan sesi")) { LegendId = "legendSesi", Extra = new[] { ("btn-outline-dark", "ri-printer-line", "Cetak Rekap Kehadiran", "Presensi.recapReport()") } }' />
                <div id="targetSesi" class="mt-3"></div>
            </div>
            <div class="tab-pane fade" id="tabJadwal" role="tabpanel">
                <div class="d-flex flex-wrap align-items-start gap-2">
                    <div class="flex-grow-1">
                        <partial name="_Toolbar" model='new ToolbarModel("Tambah Jadwal", "Presensi.add(\"Jadwal\")",
                            ("btn-outline-warning", "ri-edit-2-line", "Ubah jadwal"),
                            ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan jadwal")) { LegendId = "legendJadwal" }' />
                    </div>
                    <button type="button" class="btn btn-outline-success" onclick="Presensi.generate()"><i class="ri-magic-line align-bottom me-1"></i> Buat Sesi dari Jadwal</button>
                </div>
                <div id="targetJadwal" class="mt-3"></div>
            </div>
            <div class="tab-pane fade" id="tabNotulen" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Notulen", "Presensi.add(\"Notulen\")",
                    ("btn-outline-info", "ri-file-download-line", "Unduh lampiran"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah notulen"),
                    ("btn-outline-success", "ri-check-double-line", "Finalkan"),
                    ("btn-outline-danger", "ri-delete-bin-line", "Hapus")) { LegendId = "legendNotulen" }' />
                <div id="targetNotulen" class="mt-3"></div>
            </div>
            <div class="tab-pane fade" id="tabStatistik" role="tabpanel">
                <form class="row g-2 align-items-end" id="frmStatistik" onsubmit="return false">
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-1" for="statBulan">Rentang</label>
                        <select class="form-select" id="statBulan" name="bulan">
                            <option value="3">3 bulan</option>
                            <option value="6" selected>6 bulan</option>
                            <option value="12">12 bulan</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1" for="statSection">Section</label>
                        <select class="form-select" id="statSection" name="section">
                            <option value="">Semua section</option>
                            @foreach (var o in Model.SectionOpsi)
                            {
                                <option value="@o.Value">@o.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small mb-1" for="statAnggota">Anggota</label>
                        <select class="form-select" id="statAnggota" name="anggota">
                            <option value="">Semua anggota</option>
                            @foreach (var o in Model.AnggotaOpsi)
                            {
                                <option value="@o.Value">@o.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto ms-md-auto d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary" onclick="Presensi.refreshStats()"><i class="ri-refresh-line me-1"></i> Muat ulang</button>
                        <button type="button" class="btn btn-outline-dark" onclick="Presensi.recapReport()"><i class="ri-printer-line me-1"></i> Cetak Rekap</button>
                    </div>
                </form>
                <div id="targetStatistik" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/libs/leaflet/leaflet.css" />
}

@section Scripts {
    <script>
        window.PresensiUrl = {};
        ['Sesi', 'Jadwal', 'Notulen'].forEach(function (t) {
            ['List', 'Add', 'Edit', 'Simpan', 'Update', 'Hapus'].forEach(function (a) {
                window.PresensiUrl[a.toLowerCase() + t] = '@Url.Action("__")'.replace('__', a + t);
            });
        });
        ['BukaSesi', 'TutupSesi', 'BatalSesi', 'Qr', 'Rekap', 'RekapList', 'Manual', 'Foto', 'Generate', 'FinalNotulen', 'BerkasNotulen', 'Pantau', 'PantauList', 'CetakRekap', 'Statistik'].forEach(function (a) {
            window.PresensiUrl[a.charAt(0).toLowerCase() + a.slice(1)] = '@Url.Action("__")'.replace('__', a);
        });
    </script>
    <script>
        window.PresensiOpsi = {
            kegiatan: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KegiatanOpsi.ToDictionary(x => x.Value.ToString(), x => x.Text))),
            section: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionOpsi.ToDictionary(x => x.Value.ToString(), x => x.Text)))
        };
    </script>
    <script src="~/assets/libs/leaflet/leaflet.js"></script>
    <script src="~/js/gwa-map-picker.js" asp-append-version="true"></script>
    <script src="~/js/qrcode.min.js" asp-append-version="true"></script>
    <script src="~/Scripts/Kegiatan/Presensi.js" asp-append-version="true"></script>
}
