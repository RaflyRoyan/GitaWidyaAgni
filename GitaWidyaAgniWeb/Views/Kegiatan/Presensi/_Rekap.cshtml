@model GitaWidyaAgniWeb.Models.Kegiatan.PresensiVM.Rekap
@using GitaWidyaAgniWeb.Models.Kegiatan
@* Rekap presensi satu sesi + presensi manual (Izin / Sakit / Alpa / Hadir), juga koreksi Alpa otomatis. *@

<div class="gwa-mform" id="presensiRekap" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-list-check-3"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.Nama</div>
            <div class="gwa-mform-info-meta"><span>Baris yang sudah check-in hanya bisa Hadir atau Terlambat.</span></div>
        </div>
    </div>
    @if (Model.Status != 4)
    {
        <div class="gwa-mform-add">
            <div class="gwa-mform-add-form">
                @(Html.DevExtreme().Form<PresensiVM.ManualInput>()
                    .ID("frmManual")
                    .FormData(Model.Input)
                    .LabelLocation(FormLabelLocation.Top)
                    .ShowColonAfterLabel(false)
                    .ColCount(4)
                    .ColCountByScreen(c => c.Xs(1).Sm(1))
                    .Items(items =>
                    {
                        items.AddSimpleFor(m => m.MemberId).ColSpan(2).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih anggota..."));
                        items.AddSimpleFor(m => m.Status).Editor(e => e.SelectBox().DataSource(Model.StatusOpsi).ValueExpr("Value").DisplayExpr("Text"));
                        items.AddSimpleFor(m => m.Notes).Editor(e => e.TextBox().MaxLength(255));
                    })
                )
            </div>
            <button type="button" class="btn btn-outline-primary" onclick="Presensi.manual()"><i class="ri-save-line align-bottom me-1"></i> Catat</button>
        </div>
    }
    <div id="presensiRekapTarget">
        <partial name="~/Views/Kegiatan/Presensi/_RekapList.cshtml" model="Model.List" />
    </div>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
