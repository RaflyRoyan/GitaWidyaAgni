@model GitaWidyaAgniWeb.Models.Kegiatan.GaleriVM.Foto
@using GWAShared.Enums
@* Modal foto galeri: unggah banyak foto, ubah keterangan, jadikan sampul, hapus. *@

<div class="gwa-mform" id="galeriFoto" data-key="@Model.Key">
    <div class="gwa-mform-add">
        <div class="gwa-mform-add-form">
            @(Html.DevExtreme().FileUploader().ID("fileGaleri").UploadMode(FileUploadMode.UseForm).Multiple(true)
                .Accept("image/*").AllowedFileExtensions(new[] { ".jpg", ".jpeg", ".png", ".webp" }).MaxFileSize(10 * 1024 * 1024)
                .SelectButtonText("Pilih foto").LabelText("atau tarik beberapa foto ke sini"))
        </div>
        <button type="button" class="btn btn-outline-primary" onclick="Galeri.addPhotos()"><i class="ri-upload-2-line align-bottom me-1"></i> Unggah</button>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="text-muted text-center mb-0 py-4">Belum ada foto.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var f in Model.Items)
            {
                var cover = f.IsCover == GalleryPhotoRole.Sampul;
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="border rounded overflow-hidden h-100 d-flex flex-column @(cover ? "border-warning border-2" : "")">
                        <div class="position-relative">
                            <img src="@Url.Action("Gambar", new { key = Model.Key, id = f.Id, v = f.Stamp.Ticks })" alt="@(f.Caption ?? "Foto galeri")" class="w-100" style="aspect-ratio:4/3;object-fit:cover" loading="lazy" />
                            @if (cover)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2"><i class="ri-star-fill me-1"></i>Sampul</span>
                            }
                        </div>
                        <div class="p-2 small flex-grow-1 text-truncate" title="@f.Caption">@(f.Caption ?? "-")</div>
                        <div class="d-flex gap-1 px-2 pb-2">
                            @if (!cover)
                            {
                                <button type="button" class="btn btn-sm btn-icon btn-outline-warning" title="Jadikan sampul" aria-label="Jadikan sampul" onclick="Galeri.setCover(@f.Id)"><i class="ri-star-line"></i></button>
                            }
                            <button type="button" class="btn btn-sm btn-icon btn-outline-info" title="Ubah keterangan" aria-label="Ubah keterangan" onclick="Galeri.caption(@f.Id, this)" data-caption="@f.Caption"><i class="ri-text"></i></button>
                            <button type="button" class="btn btn-sm btn-icon btn-outline-danger ms-auto" title="Hapus foto" aria-label="Hapus foto" onclick="Galeri.removePhoto(@f.Id)"><i class="ri-delete-bin-line"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
