@model GitaWidyaAgniWeb.Models.Kegiatan.GaleriVM.Add
@using GitaWidyaAgniWeb.Models.Kegiatan
@{ var isEdit = Model is GaleriVM.Edit; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<GaleriVM.NewRow>()
        .ID("frmGaleri")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.EventDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.ActivityId).Editor(e => e.SelectBox().DataSource(Model.KegiatanOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.IsPublic).Editor(e => e.SelectBox().DataSource(Model.PublikOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.IsFeatured).Editor(e => e.SelectBox().DataSource(Model.SorotOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(90));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Galeri.@(isEdit ? "update" : "save")()"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
