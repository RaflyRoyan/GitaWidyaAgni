@model GitaWidyaAgniWeb.Models.Kegiatan.KegiatanVM.KolaboratorList
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Kegiatan

@(Html.DevExtreme().DataGrid<KegiatanVM.KolaboratorRow>()
    .ID("tblKolaborator")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .DetailGrid("Belum ada mitra yang diundang.")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Nama).Caption("Mitra").CssClass("fw-medium");
        columns.AddFor(m => m.Peran).Caption("Peran");
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Kegiatan.collabStatusTemplate"));
        columns.AddFor(m => m.RespondedAt).Caption("Direspon").DataType(GridColumnDataType.DateTime).Format("dd MMM yyyy HH:mm");
        columns.AddFor(m => m.Notes).Caption("Catatan");
        columns.AddAction("Kegiatan.collabActionTemplate");
    })
)
