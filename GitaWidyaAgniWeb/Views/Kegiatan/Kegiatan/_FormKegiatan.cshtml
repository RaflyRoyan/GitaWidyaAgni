@model GitaWidyaAgniWeb.Models.Kegiatan.KegiatanVM.AddKegiatan
@using GitaWidyaAgniWeb.Models.Kegiatan
@* Form bersama Add & Edit kegiatan. Jenis Lomba butuh lomba, audiens Divisi butuh divisi, audiens Section butuh section, audiens Tim Pelaksana butuh kegiatan induk. *@

@{
    var editModel = Model as KegiatanVM.EditKegiatan;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-calendar-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Title</div>
                <div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div>
            </div>
        </div>
    }
    @(Html.DevExtreme().Form<KegiatanVM.NewKegiatan>()
        .ID("frmKegiatan")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddGroup().Caption("Kegiatan").ColSpan(3).ColCount(3).Items(g =>
            {
                g.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
                g.AddSimpleFor(m => m.ActivityType).Editor(e => e.SelectBox().DataSource(Model.JenisOpsi).ValueExpr("Value").DisplayExpr("Text"));
                g.AddSimpleFor(m => m.StartAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
                g.AddSimpleFor(m => m.EndAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ShowClearButton(true));
                g.AddSimpleFor(m => m.CompetitionId).Editor(e => e.SelectBox().DataSource(Model.LombaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true).Placeholder("Untuk jenis Lomba"));
                g.AddSimpleFor(m => m.ProgramId).Editor(e => e.SelectBox().DataSource(Model.ProgramOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
                g.AddSimpleFor(m => m.ParentActivityId).ColSpan(2).Editor(e => e.SelectBox().DataSource(Model.IndukOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true).Placeholder("Kegiatan utama"));
                g.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(80));
            });
            items.AddGroup().Caption("Audiens & publikasi").ColSpan(3).ColCount(4).Items(g =>
            {
                g.AddSimpleFor(m => m.AudienceType).Editor(e => e.SelectBox().DataSource(Model.AudiensOpsi).ValueExpr("Value").DisplayExpr("Text"));
                g.AddSimpleFor(m => m.DivisionId).Editor(e => e.SelectBox().DataSource(Model.DivisiOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Untuk audiens Divisi"));
                g.AddSimpleFor(m => m.SectionId).Editor(e => e.SelectBox().DataSource(Model.SectionOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true).Placeholder("Untuk audiens Section (latihan sectional)"));
                g.AddSimpleFor(m => m.IsPublic).Editor(e => e.SelectBox().DataSource(Model.PublikOpsi).ValueExpr("Value").DisplayExpr("Text"));
                g.AddSimpleFor(m => m.IsFeatured).Editor(e => e.SelectBox().DataSource(Model.SorotOpsi).ValueExpr("Value").DisplayExpr("Text"));
            });
            items.AddGroup().Caption("Lokasi (titik untuk presensi)").ColSpan(3).ColCount(4).Items(g =>
            {
                g.AddSimpleFor(m => m.Location).ColSpan(2).Editor(e => e.TextBox().MaxLength(255));
                g.AddSimpleFor(m => m.Latitude).Editor(e => e.NumberBox().Format("#0.0000000").Step(0));
                g.AddSimpleFor(m => m.Longitude).Editor(e => e.NumberBox().Format("#0.0000000").Step(0));
            });
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Kegiatan.save('Kegiatan', @(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
