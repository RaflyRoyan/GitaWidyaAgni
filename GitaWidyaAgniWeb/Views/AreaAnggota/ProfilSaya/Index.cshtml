@model GitaWidyaAgniWeb.Models.AreaAnggota.ProfilSayaVM.Index
@using GitaWidyaAgniWeb.Infrastructure
@{
    ViewData["Title"] = "Profil Saya";
    var m = Model.Data;
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center">
                @if (Model.AdaFoto)
                {
                    <img src="@Url.Action("Foto")" alt="Foto profil" class="rounded-circle mb-3" width="112" height="112" style="object-fit:cover" />
                }
                else
                {
                    <div class="avatar-xl mx-auto mb-3"><span class="avatar-title rounded-circle bg-soft-warning text-warning fs-1">@((m?.Fullname ?? Model.Username).Substring(0, 1).ToUpper())</span></div>
                }
                <h5 class="mb-1">@(m?.Fullname ?? Model.Username)</h5>
                <p class="text-muted mb-2">@@@Model.Username</p>
                @if (m != null)
                {
                    <span class="badge badge-soft-primary">@EnumHelper.Text(m.MemberType)</span>
                    <span class="badge badge-soft-success">@EnumHelper.Text(m.Status)</span>
                }
            </div>
            @if (m != null)
            {
                <div class="card-body border-top">
                    <dl class="row small mb-0">
                        <dt class="col-5">No. Anggota</dt><dd class="col-7">@(m.MemberNumber ?? "-")</dd>
                        <dt class="col-5">NIM</dt><dd class="col-7">@(m.Nim ?? "-")</dd>
                        <dt class="col-5">Angkatan</dt><dd class="col-7">@(m.Angkatan?.ToString() ?? "-")</dd>
                        <dt class="col-5">Program Studi</dt><dd class="col-7">@(m.ProgramStudi ?? "-")</dd>
                        <dt class="col-5">Bergabung</dt><dd class="col-7">@(m.JoinedAt?.ToString("dd MMM yyyy") ?? "-")</dd>
                    </dl>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-8">
        @if (m == null)
        {
            <partial name="~/Views/AreaAnggota/_BukanAnggota.cshtml" />
        }
        else
        {
            <div class="card">
                <div class="card-header"><h5 class="card-title mb-0"><i class="ri-contacts-book-line align-bottom me-1"></i> Kontak</h5></div>
                <div class="card-body">
                    <form id="frmKontak" class="row g-3" novalidate>
                        <div class="col-md-6">
                            <label for="kPhone" class="form-label">No. HP / WhatsApp</label>
                            <input id="kPhone" name="Phone" class="form-control" maxlength="30" value="@Model.Kontak.Phone" autocomplete="tel" />
                        </div>
                        <div class="col-md-6">
                            <label for="kEmail" class="form-label">Email</label>
                            <input id="kEmail" name="Email" type="email" class="form-control" maxlength="100" value="@Model.Kontak.Email" autocomplete="email" />
                        </div>
                        <div class="col-12">
                            <label for="kAddress" class="form-label">Alamat</label>
                            <textarea id="kAddress" name="Address" class="form-control" rows="2" maxlength="255">@Model.Kontak.Address</textarea>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-success"><i class="ri-save-3-line align-bottom me-1"></i> Simpan Kontak</button>
                        </div>
                    </form>
                    <p class="small text-muted mb-0 mt-2">Nama, NIM, dan data keanggotaan lain diubah oleh sekretaris.</p>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h5 class="card-title mb-0"><i class="ri-music-2-line align-bottom me-1"></i> Section</h5></div>
                        <ul class="list-group list-group-flush">
                            @foreach (var s in Model.Section)
                            {
                                <li class="list-group-item small">
                                    <span class="@(s.Aktif ? "fw-semibold" : "")">@s.Nama</span>
                                    @if (s.Aktif) { <span class="badge bg-success-subtle text-success ms-1">Saat ini</span> }
                                    <div class="text-muted">@s.Rentang@(string.IsNullOrEmpty(s.Catatan) ? "" : " · " + s.Catatan)</div>
                                </li>
                            }
                            @if (Model.Section.Count == 0) { <li class="list-group-item small text-muted">Belum punya section. Hubungi sekretaris.</li> }
                        </ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h5 class="card-title mb-0"><i class="ri-user-star-line align-bottom me-1"></i> Jabatan</h5></div>
                        <ul class="list-group list-group-flush">
                            @foreach (var j in Model.Jabatan) { <li class="list-group-item small">@j</li> }
                            @if (Model.Jabatan.Count == 0) { <li class="list-group-item small text-muted">Belum ada jabatan.</li> }
                        </ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h5 class="card-title mb-0"><i class="ri-team-line align-bottom me-1"></i> Divisi</h5></div>
                        <ul class="list-group list-group-flush">
                            @foreach (var d in Model.Divisi) { <li class="list-group-item small">@d</li> }
                            @if (Model.Divisi.Count == 0) { <li class="list-group-item small text-muted">Belum masuk divisi.</li> }
                        </ul>
                    </div>
                </div>
            </div>
        }
        <div class="card mt-3">
            <div class="card-header"><h5 class="card-title mb-0"><i class="ri-lock-password-line align-bottom me-1"></i> Ganti Password</h5></div>
            <div class="card-body">
                <form id="frmPassword" class="row g-3" novalidate>
                    <div class="col-md-4">
                        <label for="pLama" class="form-label">Password lama</label>
                        <input id="pLama" name="Lama" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <div class="col-md-4">
                        <label for="pBaru" class="form-label">Password baru</label>
                        <input id="pBaru" name="Baru" type="password" class="form-control" autocomplete="new-password" minlength="8" required />
                    </div>
                    <div class="col-md-4">
                        <label for="pUlang" class="form-label">Ulangi password baru</label>
                        <input id="pUlang" name="Ulang" type="password" class="form-control" autocomplete="new-password" required />
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-warning"><i class="ri-key-2-line align-bottom me-1"></i> Ganti Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function data(form) {
                const o = {};
                $(form).serializeArray().forEach(function (x) { o[x.name] = x.value || null; });
                return o;
            }
            $('#frmKontak').on('submit', function (e) {
                e.preventDefault();
                AppUI.postJson('@Url.Action("SimpanKontak")', data(this)).done(function (r) { AppUI.alertSuccess(r.Message); });
            });
            $('#frmPassword').on('submit', function (e) {
                e.preventDefault();
                const form = this;
                AppUI.postJson('@Url.Action("GantiPassword")', data(form)).done(function (r) {
                    form.reset();
                    AppUI.alertSuccess(r.Message);
                });
            });
        })();
    </script>
}
