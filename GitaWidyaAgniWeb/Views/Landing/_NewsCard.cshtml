@model GWALib.Lib.Transaksi.Information.Announcement
@using GWAShared.Extensions
@{
    var url = Url.Action("BeritaDetail", "Landing", new { slug = Model.Slug });
}
<article class="news-card">
    <a href="@url" class="cover" tabindex="-1" aria-hidden="true">
        <img src="@Url.Action("NewsCover", "Landing", new { key = Model.EncDecrKey })" alt="" loading="lazy"
             onerror="this.src='@Url.Content("~/assets/images/gwa-logo.png")';this.style.objectFit='contain';this.style.padding='28px';">
    </a>
    <div class="body">
        <span class="tag align-self-start">@Model.Category.GetDescription()</span>
        <h3><a href="@url">@Model.Title</a></h3>
        @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
        {
            <p class="muted mb-0">@Model.Excerpt</p>
        }
        <div class="meta">
            <i class="ri-calendar-line" aria-hidden="true"></i>@Model.PublishedAt?.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
            <a href="@url" class="more ms-auto">Baca <i class="ri-arrow-right-up-line" aria-hidden="true"></i></a>
        </div>
    </div>
</article>
