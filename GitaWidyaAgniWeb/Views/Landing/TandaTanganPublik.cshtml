@model GitaWidyaAgniWeb.Models.Landing.TandaTanganPublikVM
@{
    Layout = "_LayoutLanding";
    var d = Model.Data;
    ViewData["Title"] = d != null ? "Tanda tangan " + d.SignerName : "Tanda tangan tidak dikenal";
    ViewData["SolidNav"] = true;
    var id = new System.Globalization.CultureInfo("id-ID");
}
<section class="page-hero">
    <div class="gwa-container" style="max-width:860px">
        <span class="eyebrow">Verifikasi Tanda Tangan Elektronik</span>
        <h1 class="section-title">@(d?.Title ?? "Tanda tangan tidak dikenal")</h1>
        @if (d != null)
        {
            <p class="mb-0 sub">@Model.JenisDokumen</p>
        }
    </div>
</section>

<section class="pb-5">
    <div class="gwa-container">
        <div class="article">
            @if (d == null)
            {
                <div class="apply-alert err" role="alert">
                    <i class="ri-error-warning-line" aria-hidden="true"></i>
                    <div><strong>QR tanda tangan tidak dikenal.</strong> Dokumen ini tidak diterbitkan oleh sistem @Model.OrgName, atau QR-nya rusak. Hubungi pengurus untuk memastikan keaslian dokumen.</div>
                </div>
            }
            else
            {
                <div class="asset-status ok" role="status">
                    <i class="ri-shield-check-line" aria-hidden="true"></i>
                    <div>
                        <strong>Tanda tangan sah</strong>
                        <span>· dokumen diterbitkan oleh sistem @Model.OrgName</span>
                    </div>
                </div>
                <dl class="verify-list">
                    <dt>Ditandatangani oleh</dt><dd>@d.SignerName</dd>
                    <dt>Jabatan</dt><dd>@d.SignerRole</dd>
                    @if (!string.IsNullOrWhiteSpace(d.SignerNumber)) { <dt>NIA</dt><dd>@d.SignerNumber</dd> }
                    <dt>Tanggal tanda tangan</dt><dd>@d.SignDate.ToString("d MMMM yyyy", id)</dd>
                    <dt>Jenis dokumen</dt><dd>@Model.JenisDokumen</dd>
                    <dt>Judul</dt><dd>@d.Title</dd>
                    @if (!string.IsNullOrWhiteSpace(d.Reference)) { <dt>Keterangan</dt><dd>@d.Reference</dd> }
                    <dt>Diterbitkan</dt><dd>@d.IssuedAt.ToString("d MMMM yyyy, HH:mm", id)@(d.IssuedBy == null ? "" : " oleh " + d.IssuedBy)</dd>
                    @if (d.PrintCount > 1) { <dt>Terakhir dicetak</dt><dd>@d.LastPrintedAt.ToString("d MMMM yyyy, HH:mm", id) (@d.PrintCount kali)</dd> }
                </dl>
                <p class="asset-note">Cocokkan nama, jabatan, judul, dan tanggal di atas dengan dokumen yang Anda pegang. Bila berbeda, dokumen tersebut sudah diubah.</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.WhatsApp))
            {
                <div class="hero-actions mt-3">
                    <a class="btn-gwa btn-flame" target="_blank" rel="noopener" href="https://wa.me/@Model.WhatsApp?text=@Uri.EscapeDataString("Halo, saya ingin memastikan keaslian dokumen" + (d == null ? "" : " \"" + d.Title + "\"") + ".")">
                        <i class="ri-whatsapp-line" aria-hidden="true"></i> Hubungi pengurus
                    </a>
                </div>
            }
        </div>
    </div>
</section>
