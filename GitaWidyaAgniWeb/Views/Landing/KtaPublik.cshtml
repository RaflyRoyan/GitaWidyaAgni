@model GitaWidyaAgniWeb.Models.Landing.KtaPublikVM
@using GWAShared.Enums
@using GitaWidyaAgniWeb.Infrastructure
@using GWALib.Lib.Master.Anggota
@{
    Layout = "_LayoutLanding";
    var d = Model.Data;
    ViewData["Title"] = d != null ? "KTA " + d.Fullname : "KTA tidak dikenal";
    ViewData["SolidNav"] = true;
    var id = new System.Globalization.CultureInfo("id-ID");
    var css = d == null ? "off" : d.Status == MemberStatus.Active ? "ok" : d.Status == MemberStatus.Alumni ? "busy" : "off";
}
<section class="page-hero">
    <div class="gwa-container" style="max-width:860px">
        <span class="eyebrow">Verifikasi Kartu Tanda Anggota</span>
        <h1 class="section-title">@(d?.Fullname ?? "Kartu tidak dikenal")</h1>
        @if (d?.MemberNumber != null)
        {
            <p class="mb-0 sub"><span class="shop-code">@d.MemberNumber</span></p>
        }
    </div>
</section>

<section class="pb-5">
    <div class="gwa-container">
        <div class="article">
            @if (d == null)
            {
                <div class="apply-alert err" role="alert">
                    <i class="ri-error-warning-line" aria-hidden="true"></i>
                    <div><strong>QR kartu tidak dikenal.</strong> Kartu ini palsu, atau QR-nya sudah diganti karena kartu dilaporkan hilang. Hubungi pengurus @Model.OrgName.</div>
                </div>
            }
            else
            {
                <div class="kta-verify">
                    @if (d.HasPhoto && d.Valid)
                    {
                        <img class="kta-photo" src="@Url.Action("KtaFoto", "Landing", new { kode = Model.Token })" alt="Foto @d.Fullname" loading="lazy" />
                    }
                    <div class="flex-grow-1">
                        <div class="asset-status @css" role="status">
                            <i class="@(css == "ok" ? "ri-shield-check-line" : css == "busy" ? "ri-graduation-cap-line" : "ri-close-circle-line")" aria-hidden="true"></i>
                            <div>
                                <strong>@(d.Status == MemberStatus.Active ? "Anggota aktif" : d.Status == MemberStatus.Alumni ? "Alumni" : "Kartu tidak berlaku")</strong>
                                <span>· @(d.Valid ? "kartu sah milik " + Model.OrgName : "anggota sudah tidak aktif")</span>
                            </div>
                        </div>
                        <dl class="verify-list">
                            <dt>Nama</dt><dd>@d.Fullname</dd>
                            <dt>NIA</dt><dd>@(d.MemberNumber ?? "-")</dd>
                            @if (d.Valid)
                            {
                                @if (!string.IsNullOrWhiteSpace(d.Section)) { <dt>Section</dt><dd>@d.Section</dd> }
                                @if (!string.IsNullOrWhiteSpace(d.Position)) { <dt>Jabatan</dt><dd>@d.Position@(d.PeriodName == null ? "" : " · " + d.PeriodName)</dd> }
                                @if (d.Angkatan != null) { <dt>Angkatan</dt><dd>@d.Angkatan</dd> }
                                @if (d.JoinedAt != null) { <dt>Bergabung</dt><dd>@d.JoinedAt.Value.ToString("d MMMM yyyy", id) (@Member.TenureText(d.JoinedAt))</dd> }
                                @if (d.ValidUntil != null) { <dt>Berlaku s.d.</dt><dd>@d.ValidUntil.Value.ToString("d MMMM yyyy", id)</dd> }
                            }
                            <dt>Kartu diterbitkan</dt><dd>@d.IssuedAt.ToString("d MMMM yyyy", id)</dd>
                        </dl>
                    </div>
                </div>
                <p class="asset-note">Status di halaman ini selalu yang terbaru dari data @Model.OrgName, bukan dari kartu fisik.</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.WhatsApp))
            {
                <div class="hero-actions mt-3">
                    <a class="btn-gwa btn-flame" target="_blank" rel="noopener" href="https://wa.me/@Model.WhatsApp?text=@Uri.EscapeDataString("Halo, saya ingin memastikan keaslian KTA" + (d == null ? "" : " a.n. " + d.Fullname) + ".")">
                        <i class="ri-whatsapp-line" aria-hidden="true"></i> Hubungi pengurus
                    </a>
                </div>
            }
        </div>
    </div>
</section>
