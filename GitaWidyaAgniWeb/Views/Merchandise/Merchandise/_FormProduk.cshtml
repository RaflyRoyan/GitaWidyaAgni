@model GitaWidyaAgniWeb.Models.Merchandise.MerchandiseVM.AddProduk
@using GitaWidyaAgniWeb.Models.Merchandise
@* Stok awal hanya saat dibuat (produk tanpa varian); setelahnya lewat mutasi stok. Produk ber-varian: stok di varian. *@
@{ var isEdit = Model is MerchandiseVM.EditProduk; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<MerchandiseVM.NewProduk>()
        .ID("frmProduk")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).ColSpan(2).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.ProductType).Editor(e => e.SelectBox().DataSource(Model.JenisOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Price).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0"));
            items.AddSimpleFor(m => m.CostPrice).Editor(e => e.NumberBox().Min(0).Format("Rp #,##0"));
            items.AddSimpleFor(m => m.Unit).Editor(e => e.TextBox().MaxLength(30));
            items.AddSimpleFor(m => m.TrackStock).Editor(e => e.SelectBox().DataSource(Model.LacakOpsi).ValueExpr("Value").DisplayExpr("Text"));
            if (!isEdit)
            {
                items.AddSimpleFor(m => m.Stock).Editor(e => e.NumberBox().Min(0).ShowSpinButtons(true).Format("#0"));
            }
            items.AddSimpleFor(m => m.IsPreorder).Editor(e => e.SelectBox().DataSource(Model.ModeOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.PreorderCloseAt).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ShowClearButton(true));
            items.AddSimpleFor(m => m.ActivityId).Editor(e => e.SelectBox().DataSource(Model.KegiatanOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(70));
        })
    )
    <div class="gwa-mform-section"><span class="gwa-mform-section-title">Foto produk</span></div>
    @if (Model.HasPhoto)
    {
        <label class="form-check-label small mb-1"><input type="checkbox" class="form-check-input me-1" id="chkHapusFotoProduk" /> Hapus foto</label>
    }
    @(Html.DevExtreme().FileUploader().ID("fileProduk").UploadMode(FileUploadMode.UseForm).Multiple(false)
        .Accept("image/*").AllowedFileExtensions(new[] { ".jpg", ".jpeg", ".png", ".webp" }).MaxFileSize(10 * 1024 * 1024).SelectButtonText("Pilih foto").LabelText(""))
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Merchandise.saveProduct(@(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
