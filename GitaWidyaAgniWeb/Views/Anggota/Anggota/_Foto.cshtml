@model GitaWidyaAgniWeb.Models.Anggota.AnggotaVM.Foto
@* Modal foto anggota: unggah + daftar foto (foto pertama dipakai sebagai avatar). *@

<div class="gwa-mform" id="anggotaFoto" data-key="@Model.Key">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-image-line"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.Nama</div>
            <div class="gwa-mform-info-meta"><span>Foto diperkecil otomatis. Foto pertama dipakai sebagai avatar.</span></div>
        </div>
    </div>

    <div class="gwa-mform-add">
        <div class="gwa-mform-add-form">
            @(Html.DevExtreme().FileUploader().ID("fileAnggotaFoto").UploadMode(FileUploadMode.UseForm).Multiple(false)
                .Accept("image/*").AllowedFileExtensions(new[] { ".jpg", ".jpeg", ".png", ".webp" }).MaxFileSize(10 * 1024 * 1024)
                .SelectButtonText("Pilih foto").LabelText("atau tarik foto ke sini"))
        </div>
        <button type="button" class="btn btn-outline-primary" onclick="Anggota.addPhoto()"><i class="ri-upload-2-line align-bottom me-1"></i> Unggah</button>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="text-muted text-center mb-0 py-4">Belum ada foto.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var f in Model.Items)
            {
                <div class="col-6 col-md-4">
                    <div class="border rounded overflow-hidden">
                        <img src="@Url.Action("Gambar", new { key = Model.Key, id = f.Id, v = f.Stamp.Ticks })" alt="Foto @Model.Nama" class="w-100" style="aspect-ratio:1;object-fit:cover" loading="lazy" />
                        <div class="d-flex align-items-center justify-content-between px-2 py-1 small bg-light">
                            <span class="text-muted">@((f.FileSize / 1024.0).ToString("0")) KB</span>
                            <button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Hapus foto" aria-label="Hapus foto" onclick="Anggota.removePhoto(@f.Id)"><i class="ri-delete-bin-line"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    </div>
</div>
