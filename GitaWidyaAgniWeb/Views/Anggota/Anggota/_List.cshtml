@model GitaWidyaAgniWeb.Models.Anggota.AnggotaVM.List
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Anggota

@(Html.DevExtreme().DataGrid<AnggotaVM.Row>()
    .ID("tblGrid")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Data Anggota")
    .OnRowPrepared("AppUI.inactiveRowPrepared")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Fullname).Caption("Nama").CellTemplate(new JS("Anggota.nameTemplate"));
        columns.AddFor(m => m.MemberNumber).Caption("No. Anggota").CellTemplate(new JS("AppUI.codeTemplate"));
        columns.AddFor(m => m.Nim).Caption("NIM");
        columns.AddFor(m => m.Kategori).Caption("Kategori").Visible(false);
        columns.AddFor(m => m.Section).Caption("Section");
        columns.AddFor(m => m.Prodi).Caption("Prodi / Instansi");
        columns.AddFor(m => m.Angkatan).Caption("Angkatan").Alignment(HorizontalAlignment.Center).Width(95);
        columns.AddFor(m => m.Lama).Caption("Lama Bergabung").AllowFiltering(false);
        columns.AddFor(m => m.Tipe).Caption("Tipe").Alignment(HorizontalAlignment.Center);
        columns.AddFor(m => m.StatusText).Caption("Status").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("Anggota.statusTemplate"));
        columns.AddFor(m => m.Username).Caption("Akun").CellTemplate(new JS("AppUI.codeTemplate"));
        columns.AddFor(m => m.Phone).Caption("Telepon").Visible(false);
        columns.AddFor(m => m.Email).Caption("Email").Visible(false);
        columns.AddFor(m => m.JoinedAt).Caption("Bergabung").DataType(GridColumnDataType.Date).Format("dd MMM yyyy").Visible(false);
        columns.AddAction("Anggota.actionTemplate");
    })
)
