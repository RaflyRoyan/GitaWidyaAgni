@model GitaWidyaAgniWeb.Models.Anggota.RekrutmenVM.Add
@using GitaWidyaAgniWeb.Models.Anggota
@* Form bersama Add & Edit rekrutmen. Rekrutmen baru selalu Draft; buka / tutup lewat tombol di grid. *@

@{
    var editModel = Model as RekrutmenVM.Edit;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-user-add-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Title</div>
                <div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div>
            </div>
        </div>
    }

    @(Html.DevExtreme().Form<RekrutmenVM.NewRow>()
        .ID("frmRekrutmen")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(150).Placeholder("mis. Open Recruitment Anggota Baru 2026"));
            items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.AcceptPublic).Editor(e => e.SelectBox().DataSource(Model.AudiensOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.OpenDate).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
            items.AddSimpleFor(m => m.CloseDate).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss"));
            items.AddSimpleFor(m => m.Quota).Editor(e => e.NumberBox().Min(1).Format("#0").ShowClearButton(true));
            items.AddSimpleFor(m => m.Description).ColSpan(2).Editor(e => e.TextArea().Height(130));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Rekrutmen.@(isEdit ? "update" : "save")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
