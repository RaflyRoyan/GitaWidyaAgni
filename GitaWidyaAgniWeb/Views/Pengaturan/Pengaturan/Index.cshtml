@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Pengaturan Sistem";
    // Id tab = akhiran nama aksi List<Id> dan target #target<Id>. Grid tiap tab dimuat saat tab pertama kali dibuka.
    var tabs = new (string Id, string Icon, string Name)[]
    {
        ("Setting", "ri-global-line", "Pengaturan Situs"), ("Format", "ri-hashtag", "Format Nomor"), ("Flow", "ri-git-merge-line", "Alur Persetujuan"),
        ("Template", "ri-mail-settings-line", "Template Pesan"), ("Outbox", "ri-send-plane-line", "Antrian Pesan"), ("Job", "ri-timer-line", "Log Job"),
        ("Log", "ri-history-line", "Log Aktivitas"), ("Sequence", "ri-sort-number-asc", "Sequence ID")
    };
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-settings-3-line align-bottom me-1"></i> Pengaturan Sistem</h5>
        <p class="gwa-card-intro">Isi landing page, penomoran dokumen, alur persetujuan, template pesan, serta pemantauan antrian pesan, job terjadwal, dan log aktivitas.</p>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs gwa-tabs mb-3 flex-nowrap overflow-auto" role="tablist">
            @foreach (var t in tabs)
            {
                <li class="nav-item"><button class="nav-link text-nowrap @(t.Id == "Setting" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab@(t.Id)" data-tab="@t.Id" type="button" role="tab"><i class="@t.Icon me-1"></i>@t.Name</button></li>
            }
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabSetting" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Dipakai landing page (kunci seperti <span class="gwa-code">hero_title</span>, <span class="gwa-code">whatsapp</span>, <span class="gwa-code">instagram</span>).</p>
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Pengaturan", "Pengaturan.addSetting()",
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah pengaturan"),
                    ("btn-outline-danger", "ri-delete-bin-line", "Hapus pengaturan")) { LegendId = "legendSetting" }' />
                <div id="targetSetting" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabFormat" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Placeholder: <span class="gwa-code">{seq}</span> <span class="gwa-code">{type}</span> <span class="gwa-code">{org}</span> <span class="gwa-code">{month_roman}</span> <span class="gwa-code">{month}</span> <span class="gwa-code">{year}</span> <span class="gwa-code">{yy}</span></p>
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Format Nomor", "Pengaturan.addFormat()",
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah format"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan format")) { LegendId = "legendFormat" }' />
                <div id="targetFormat" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabFlow" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Satu alur aktif per jenis dokumen (FUNDING_REQUEST, PROCUREMENT, LETTER). Buka baris untuk melihat dan mengatur langkahnya.</p>
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Alur", "Pengaturan.addFlow()",
                    ("btn-outline-success", "ri-add-circle-line", "Tambah langkah"),
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah alur / langkah"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan alur / hapus langkah")) { LegendId = "legendFlow" }' />
                <div id="targetFlow" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabTemplate" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Satu template per kode dan kanal. Variabel ditulis <span class="gwa-code">{name}</span>, <span class="gwa-code">{link}</span>, dst.</p>
                <partial name="_Toolbar" model='new ToolbarModel("Tambah Template", "Pengaturan.addTemplate()",
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah template"),
                    ("btn-outline-danger", "ri-forbid-line", "Nonaktifkan template")) { LegendId = "legendTemplate" }' />
                <div id="targetTemplate" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabOutbox" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel(null, null,
                    ("btn-outline-secondary", "ri-eye-line", "Lihat pesan"),
                    ("btn-outline-warning", "ri-restart-line", "Kirim ulang (gagal)"),
                    ("btn-outline-danger", "ri-close-circle-line", "Batalkan pesan")) { LegendId = "legendOutbox" }' />
                <div id="targetOutbox" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabJob" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Riwayat job terjadwal, terbaru di atas.</p>
                <div id="targetJob"></div>
            </div>

            <div class="tab-pane fade" id="tabLog" role="tabpanel">
                <partial name="_Toolbar" model='new ToolbarModel(null, null,
                    ("btn-outline-secondary", "ri-eye-line", "Detail log")) { LegendId = "legendLog" }' />
                <div id="targetLog" class="mt-3"></div>
            </div>

            <div class="tab-pane fade" id="tabSequence" role="tabpanel">
                <p class="gwa-mform-note mt-0 mb-2">Id terakhir per tabel. Nilai tidak boleh di bawah MAX(id) tabelnya; ubah hanya untuk perbaikan data.</p>
                <partial name="_Toolbar" model='new ToolbarModel(null, null,
                    ("btn-outline-warning", "ri-edit-2-line", "Ubah id terakhir")) { LegendId = "legendSequence" }' />
                <div id="targetSequence" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.PengaturanUrl = {
            listSetting: '@Url.Action("ListSetting")', addSetting: '@Url.Action("AddSetting")', editSetting: '@Url.Action("EditSetting")',
            simpanSetting: '@Url.Action("SimpanSetting")', updateSetting: '@Url.Action("UpdateSetting")', hapusSetting: '@Url.Action("DeleteSetting")',
            gambarSetting: '@Url.Action("GambarSetting")',
            listFormat: '@Url.Action("ListFormat")', addFormat: '@Url.Action("AddFormat")', editFormat: '@Url.Action("EditFormat")',
            simpanFormat: '@Url.Action("SimpanFormat")', updateFormat: '@Url.Action("UpdateFormat")', hapusFormat: '@Url.Action("DeleteFormat")',
            listFlow: '@Url.Action("ListFlow")', addFlow: '@Url.Action("AddFlow")', editFlow: '@Url.Action("EditFlow")',
            simpanFlow: '@Url.Action("SimpanFlow")', updateFlow: '@Url.Action("UpdateFlow")', hapusFlow: '@Url.Action("DeleteFlow")',
            addStep: '@Url.Action("AddStep")', editStep: '@Url.Action("EditStep")',
            simpanStep: '@Url.Action("SimpanStep")', updateStep: '@Url.Action("UpdateStep")', hapusStep: '@Url.Action("DeleteStep")',
            listTemplate: '@Url.Action("ListTemplate")', addTemplate: '@Url.Action("AddTemplate")', editTemplate: '@Url.Action("EditTemplate")',
            simpanTemplate: '@Url.Action("SimpanTemplate")', updateTemplate: '@Url.Action("UpdateTemplate")', hapusTemplate: '@Url.Action("DeleteTemplate")',
            listOutbox: '@Url.Action("ListOutbox")', detailOutbox: '@Url.Action("DetailOutbox")',
            retryOutbox: '@Url.Action("RetryOutbox")', cancelOutbox: '@Url.Action("CancelOutbox")',
            listJob: '@Url.Action("ListJob")',
            listLog: '@Url.Action("ListLog")', detailLog: '@Url.Action("DetailLog")',
            listSequence: '@Url.Action("ListSequence")', editSequence: '@Url.Action("EditSequence")', updateSequence: '@Url.Action("UpdateSequence")'
        };
    </script>
    <script src="~/Scripts/Pengaturan/Pengaturan.js" asp-append-version="true"></script>
}
