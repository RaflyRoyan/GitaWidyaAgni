@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.FormFormat

<form id="frmFormat" data-edit="@(Model.IsEdit ? "1" : "0")" onsubmit="return false">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Jenis dokumen</label>
            @(Html.DevExtreme().TextBox().ID("DocumentType").Value(Model.DocumentType).MaxLength(50).ReadOnly(Model.IsEdit)
                .Placeholder("LETTER, FUNDING_REQUEST, SURAT UND"))
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label gwa-required">Nomor urut direset</label>
            @(Html.DevExtreme().SelectBox().ID("ResetPeriod").Value(Model.ResetPeriod)
                .DataSource(GitaWidyaAgniWeb.Models.GwaVM.Opsi<GWAShared.Enums.NumberResetPeriod>()).ValueExpr("Value").DisplayExpr("Text"))
        </div>
        <div class="col-md-8 mb-3">
            <label class="form-label gwa-required">Format</label>
            @(Html.DevExtreme().TextBox().ID("NumberFormat").Value(Model.NumberFormat).MaxLength(100).Placeholder("{seq}/{org}/SK/{month_roman}/{year}"))
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label gwa-required">Digit nomor urut</label>
            @(Html.DevExtreme().NumberBox().ID("SeqPadding").Value(Model.SeqPadding).Min(1).Max(10).ShowSpinButtons(true).Format("#0"))
        </div>
        <div class="col-12 mb-3">
            <label class="form-label">Keterangan</label>
            @(Html.DevExtreme().TextBox().ID("FormatDescription").Value(Model.Description).MaxLength(200))
        </div>
        @if (Model.IsEdit)
        {
            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                @(Html.DevExtreme().SelectBox().ID("FormatIsActive").Value(Model.IsActive)
                    .DataSource(GitaWidyaAgniWeb.Models.GwaVM.OpsiAktif).ValueExpr("Value").DisplayExpr("Text"))
            </div>
        }
    </div>
</form>
<div class="hstack gap-2 justify-content-end">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Tutup</button>
    <button type="button" class="btn btn-primary" onclick="fnSimpanFormat()"><i class="ri-save-line me-1"></i>Simpan</button>
</div>
