@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.AddFlow
@using GitaWidyaAgniWeb.Models.Pengaturan
@* Form bersama modal Add & Edit Alur Persetujuan. Jenis dokumen tidak bisa diubah. *@

@{
    var editModel = Model as PengaturanVM.EditFlow;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-git-merge-line"></i></span>
            <div>
                <div class="gwa-mform-info-title">@Model.Row.Name</div>
                <div class="gwa-mform-info-meta">
                    <span>Jenis <b>@Model.Row.DocumentType</b></span>
                    <span><b>@editModel!.JumlahLangkah</b> langkah</span>
                </div>
            </div>
        </div>
    }

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Alur persetujuan</span>
        <span class="gwa-mform-section-hint">Alur aktif minimal punya satu langkah</span>
    </div>
    @(Html.DevExtreme().Form<PengaturanVM.NewFlow>()
        .ID("frmFlow")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.DocumentType)
                .Editor(e => e.SelectBox().DataSource(Model.JenisList).AcceptCustomValue(true).ReadOnly(isEdit).Placeholder("Pilih atau ketik..."));
            items.AddSimpleFor(m => m.Name).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Pengajuan Dana Kegiatan"));
            items.AddSimpleFor(m => m.Description).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Pengaturan.@(isEdit ? "updateFlow" : "saveFlow")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
