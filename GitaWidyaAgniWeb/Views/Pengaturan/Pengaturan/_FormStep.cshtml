@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.AddStep
@using GitaWidyaAgniWeb.Models.Pengaturan
@* Form bersama modal Add & Edit Langkah. Pilihan penyetuju yang tampil mengikuti jenisnya (Pengaturan.stepFormChanged). *@

@{
    var isEdit = Model is PengaturanVM.EditStep;
}

<div class="gwa-mform">
    <div class="gwa-mform-info">
        <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-git-merge-line"></i></span>
        <div>
            <div class="gwa-mform-info-title">@Model.NamaAlur</div>
            <div class="gwa-mform-info-meta"><span><b>Role</b>: user dengan role itu; <b>Jabatan</b>: pemegang jabatan di periode aktif; <b>User tertentu</b>.</span></div>
        </div>
    </div>

    @(Html.DevExtreme().Form<PengaturanVM.NewStep>()
        .ID("frmStep")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(4)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .OnFieldDataChanged("Pengaturan.stepFormChanged")
        .OnContentReady("Pengaturan.stepFormChanged")
        .Items(items =>
        {
            items.AddSimpleFor(m => m.StepLevel).HelpText("0 = berikutnya")
                .Editor(e => e.NumberBox().Min(0).ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.StepName).ColSpan(3)
                .Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Verifikasi Bendahara"));
            items.AddSimpleFor(m => m.ApproverType).ColSpan(2)
                .Editor(e => e.SelectBox().DataSource(Model.JenisList).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.AllowRevision).ColSpan(2)
                .Editor(e => e.SelectBox().DataSource(Model.RevisiList).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.RoleId).ColSpan(4).Name("RoleId")
                .Editor(e => e.SelectBox().DataSource(Model.RoleList).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih role..."));
            items.AddSimpleFor(m => m.PositionId).ColSpan(4).Name("PositionId")
                .Editor(e => e.SelectBox().DataSource(Model.PositionList).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih jabatan..."));
            items.AddSimpleFor(m => m.UserId).ColSpan(4).Name("UserId")
                .Editor(e => e.SelectBox().DataSource(Model.UserList).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).Placeholder("Pilih user..."));
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Pengaturan.@(isEdit ? "updateStep" : "saveStep")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
