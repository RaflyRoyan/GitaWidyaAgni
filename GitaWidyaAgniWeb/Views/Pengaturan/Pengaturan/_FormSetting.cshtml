@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.AddSetting
@using GitaWidyaAgniWeb.Models.Pengaturan
@* Form bersama modal Add & Edit Pengaturan Situs. Dikirim FormData (Pengaturan.saveSetting) karena ada gambar. *@

@{
    var editModel = Model as PengaturanVM.EditSetting;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Pengaturan</span>
        <span class="gwa-mform-section-hint">@(isEdit ? "Kunci tidak bisa diubah" : "Kunci disimpan sebagai snake_case")</span>
    </div>
    @(Html.DevExtreme().Form<PengaturanVM.NewSetting>()
        .ID("frmSetting")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.SettingGroup)
                .Editor(e => e.TextBox().MaxLength(50).Placeholder("LANDING").InputAttr(new { style = "text-transform:uppercase" }));
            items.AddSimpleFor(m => m.SettingKey).ColSpan(2)
                .Editor(e => e.TextBox().MaxLength(100).ReadOnly(isEdit).Placeholder("hero_title"));
            items.AddSimpleFor(m => m.SettingValue).ColSpan(3)
                .Editor(e => e.TextArea().Height(100));
            items.AddSimpleFor(m => m.Description).ColSpan(3)
                .Editor(e => e.TextBox().MaxLength(200));
            if (editModel?.HasImage == true)
            {
                items.AddSimpleFor(m => m.HapusGambar).ColSpan(3).Label(l => l.Visible(false))
                    .Editor(e => e.CheckBox().Text("Hapus gambar saat ini"));
            }
        })
    )

    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Gambar</span>
        <span class="gwa-mform-section-hint">Opsional. JPG, PNG, atau WebP, maksimal 5 MB</span>
    </div>
    <div class="row g-3 align-items-start">
        <div class="@(editModel?.HasImage == true ? "col-md-8" : "col-12")">
            @(Html.DevExtreme().FileUploader().ID("fileSettingImage").UploadMode(FileUploadMode.UseForm).Multiple(false)
                .Accept("image/*").AllowedFileExtensions(new[] { ".jpg", ".jpeg", ".png", ".webp" }).MaxFileSize(5 * 1024 * 1024)
                .SelectButtonText("Pilih gambar").LabelText("atau tarik gambar ke sini"))
        </div>
        @if (editModel?.HasImage == true)
        {
            <div class="col-md-4">
                <a href="@editModel.ImageUrl" target="_blank" rel="noopener" class="d-block">
                    <img src="@editModel.ImageUrl" alt="Gambar pengaturan saat ini" class="img-fluid rounded border" style="max-height:110px" />
                </a>
            </div>
        }
    </div>

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Pengaturan.saveSetting(@(isEdit ? "true" : "false"))">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
