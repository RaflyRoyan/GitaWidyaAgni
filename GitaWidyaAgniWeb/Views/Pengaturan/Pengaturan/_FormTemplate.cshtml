@model GitaWidyaAgniWeb.Models.Pengaturan.PengaturanVM.AddTemplate
@using GitaWidyaAgniWeb.Models.Pengaturan
@* Form bersama modal Add & Edit Template Pesan. Kode dan kanal tidak bisa diubah; status hanya di Edit. *@

@{
    var isEdit = Model is PengaturanVM.EditTemplate;
}

<div class="gwa-mform">
    <div class="gwa-mform-section">
        <span class="gwa-mform-section-title">Template pesan</span>
        <span class="gwa-mform-section-hint">Variabel ditulis {name}, {link}, dst.</span>
    </div>
    @(Html.DevExtreme().Form<PengaturanVM.NewTemplate>()
        .ID("frmTemplate")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.TemplateCode)
                .Editor(e => e.TextBox().MaxLength(50).ReadOnly(isEdit).Placeholder("RESET_PASSWORD"));
            items.AddSimpleFor(m => m.Channel)
                .Editor(e => e.SelectBox().DataSource(Model.KanalList).ValueExpr("Value").DisplayExpr("Text").ReadOnly(isEdit));
            items.AddSimpleFor(m => m.Subject).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.Body).ColSpan(2).Editor(e => e.TextArea().Height(160));
            items.AddSimpleFor(m => m.Description).ColSpan(isEdit ? 1 : 2).Editor(e => e.TextBox().MaxLength(200));
            if (isEdit)
            {
                items.AddSimpleFor(m => m.IsActive).Editor(e => e.SelectBox().DataSource(Model.AktifList).ValueExpr("Value").DisplayExpr("Text"));
            }
        })
    )

    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Pengaturan.@(isEdit ? "updateTemplate" : "saveTemplate")()">
            <i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")
        </button>
    </div>
</div>
