@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.AddLomba
@using GitaWidyaAgniWeb.Models.Prestasi
@* Disorot hanya bila publik. Poster maks. 5 MB, diubah ukurannya oleh sistem. Status diubah dari tombol status di daftar. *@
@{
    var editModel = Model as PrestasiVM.EditLomba;
    var isEdit = editModel != null;
}

<div class="gwa-mform">
    @if (isEdit)
    {
        <div class="gwa-mform-info">
            <span class="gwa-mform-info-icon" aria-hidden="true"><i class="ri-flag-2-line"></i></span>
            <div><div class="gwa-mform-info-title">@Model.Row.Name</div><div class="gwa-mform-info-meta"><span>Status <b>@editModel!.StatusText</b></span></div></div>
        </div>
    }
    @(Html.DevExtreme().Form<PrestasiVM.NewLomba>()
        .ID("frmLomba")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Name).ColSpan(2).Editor(e => e.TextBox().MaxLength(200));
            items.AddSimpleFor(m => m.Level).Editor(e => e.SelectBox().DataSource(Model.TingkatOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Organizer).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.Category).Editor(e => e.TextBox().MaxLength(100).Placeholder("mis. Marching Band"));
            items.AddSimpleFor(m => m.RegistrationDeadline).Editor(e => e.DateBox().Type(DateBoxType.DateTime).DisplayFormat("dd MMM yyyy HH:mm").DateSerializationFormat("yyyy-MM-ddTHH:mm:ss").ShowClearButton(true));
            items.AddSimpleFor(m => m.StartDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.EndDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd").ShowClearButton(true));
            items.AddSimpleFor(m => m.Location).Editor(e => e.TextBox().MaxLength(255));
            items.AddSimpleFor(m => m.LinkUrl).ColSpan(2).Editor(e => e.TextBox().MaxLength(255).Placeholder("https://..."));
            items.AddSimpleFor(m => m.Publik).Editor(e => e.CheckBox());
            items.AddSimpleFor(m => m.Disorot).Editor(e => e.CheckBox());
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(90));
        })
    )
    <div class="gwa-mform-section"><span class="gwa-mform-section-title">Poster</span><span class="gwa-mform-section-hint">JPG / PNG, maks. 5 MB</span></div>
    @if (Model.HasPoster)
    {
        <div class="gwa-mform-note d-flex align-items-center gap-2">
            <img src="@Url.Action("Poster", new { key = editModel!.Key })" alt="Poster lomba" style="height:64px;border-radius:6px" />
            <label class="ms-auto form-check-label"><input type="checkbox" class="form-check-input me-1" id="chkHapusPoster" /> Hapus poster</label>
        </div>
    }
    @(Html.DevExtreme().FileUploader().ID("filePoster").UploadMode(FileUploadMode.UseForm).Multiple(false).Accept("image/*")
        .MaxFileSize(5 * 1024 * 1024).SelectButtonText("Pilih poster").LabelText(""))
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Prestasi.saveCompetition(@(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
