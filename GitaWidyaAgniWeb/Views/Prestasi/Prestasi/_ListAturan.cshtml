@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.ListAturan
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Prestasi

@(Html.DevExtreme().DataGrid<PrestasiVM.AturanRow>()
    .ID("tblAturanPoin")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Aturan Poin")
    .OnRowPrepared("AppUI.inactiveRowPrepared")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Sumber).Caption("Sumber").CssClass("fw-medium");
        columns.AddFor(m => m.JenisKegiatan).Caption("Jenis Kegiatan");
        columns.AddFor(m => m.Tingkat).Caption("Tingkat");
        columns.AddFor(m => m.Points).Caption("Poin").Alignment(HorizontalAlignment.Right);
        columns.AddFor(m => m.Description).Caption("Keterangan");
        columns.AddFor(m => m.Aktif).Caption("Aktif").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddAction("Prestasi.ruleActionTemplate");
    })
)
