@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.AddMateri
@using GitaWidyaAgniWeb.Models.Prestasi
@* File wajib berkas (maks. 20 MB), Link wajib URL, Video wajib URL atau berkas. *@
@{ var isEdit = Model is PrestasiVM.EditMateri; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<PrestasiVM.NewMateri>()
        .ID("frmMateri")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(3).Editor(e => e.TextBox().MaxLength(255));
            items.AddSimpleFor(m => m.CompetitionId).Editor(e => e.SelectBox().DataSource(Model.LombaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.MaterialType).Editor(e => e.SelectBox().DataSource(Model.JenisOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Visibility).Editor(e => e.SelectBox().DataSource(Model.VisibilitasOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Url).ColSpan(3).Editor(e => e.TextBox().MaxLength(500).Placeholder("https://..."));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(70).MaxLength(1000));
        })
    )
    <div class="gwa-mform-section"><span class="gwa-mform-section-title">Berkas @(isEdit ? "(kosongkan bila tidak diganti)" : "")</span><span class="gwa-mform-section-hint">maks. 20 MB</span></div>
    @if (!string.IsNullOrEmpty(Model.FileName))
    {
        <div class="gwa-mform-note"><i class="ri-file-text-line me-1"></i>@Model.FileName</div>
    }
    @(Html.DevExtreme().FileUploader().ID("fileMateri").UploadMode(FileUploadMode.UseForm).Multiple(false)
        .MaxFileSize(20 * 1024 * 1024).SelectButtonText("Pilih berkas").LabelText(""))
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Prestasi.saveMaterial(@(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
