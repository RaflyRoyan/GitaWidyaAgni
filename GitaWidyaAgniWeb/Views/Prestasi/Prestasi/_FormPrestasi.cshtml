@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.AddPrestasi
@using GitaWidyaAgniWeb.Models.Prestasi
@* Wajib anggota atau nama tim. Prestasi anggota mendapat poin Prestasi (aturan aktif). Sertifikat dan foto maks. 5 MB. *@
@{ var isEdit = Model is PrestasiVM.EditPrestasi; }

<div class="gwa-mform">
    @(Html.DevExtreme().Form<PrestasiVM.NewPrestasi>()
        .ID("frmPrestasi")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(3)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.Title).ColSpan(2).Editor(e => e.TextBox().MaxLength(255).Placeholder("mis. Juara 1 Display Marching"));
            items.AddSimpleFor(m => m.RankTitle).Editor(e => e.TextBox().MaxLength(100));
            items.AddSimpleFor(m => m.CompetitionId).ColSpan(2).Editor(e => e.SelectBox().DataSource(Model.LombaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.Level).Editor(e => e.SelectBox().DataSource(Model.TingkatOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.MemberId).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true).ShowClearButton(true));
            items.AddSimpleFor(m => m.TeamName).Editor(e => e.TextBox().MaxLength(150));
            items.AddSimpleFor(m => m.AchievedDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.Description).ColSpan(3).Editor(e => e.TextArea().Height(70));
            items.AddSimpleFor(m => m.Publik).Editor(e => e.CheckBox());
            items.AddSimpleFor(m => m.Disorot).Editor(e => e.CheckBox());
        })
    )
    <div class="row g-3">
        <div class="col-md-6">
            <div class="gwa-mform-section"><span class="gwa-mform-section-title">Sertifikat</span><span class="gwa-mform-section-hint">PDF / gambar, maks. 5 MB</span></div>
            @if (!string.IsNullOrEmpty(Model.CertificateFileName))
            {
                <div class="gwa-mform-note d-flex align-items-center gap-2">
                    <i class="ri-file-paper-2-line"></i><span>@Model.CertificateFileName</span>
                    <label class="ms-auto form-check-label"><input type="checkbox" class="form-check-input me-1" id="chkHapusSertifikat" /> Hapus</label>
                </div>
            }
            @(Html.DevExtreme().FileUploader().ID("fileSertifikatPrestasi").UploadMode(FileUploadMode.UseForm).Multiple(false)
                .MaxFileSize(5 * 1024 * 1024).SelectButtonText("Pilih sertifikat").LabelText(""))
        </div>
        <div class="col-md-6">
            <div class="gwa-mform-section"><span class="gwa-mform-section-title">Foto</span><span class="gwa-mform-section-hint">JPG / PNG, maks. 5 MB</span></div>
            @if (Model.HasPhoto)
            {
                <div class="gwa-mform-note d-flex align-items-center gap-2">
                    <img src="@Url.Action("FotoPrestasi", new { key = Model.Key })" alt="Foto prestasi" style="height:56px;border-radius:6px" />
                    <label class="ms-auto form-check-label"><input type="checkbox" class="form-check-input me-1" id="chkHapusFotoPrestasi" /> Hapus</label>
                </div>
            }
            @(Html.DevExtreme().FileUploader().ID("fileFotoPrestasi").UploadMode(FileUploadMode.UseForm).Multiple(false).Accept("image/*")
                .MaxFileSize(5 * 1024 * 1024).SelectButtonText("Pilih foto").LabelText(""))
        </div>
    </div>
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Prestasi.saveAchievement(@(isEdit ? "true" : "false"))"><i class="ri-save-3-line align-bottom me-1"></i> @(isEdit ? "Simpan Perubahan" : "Simpan")</button>
    </div>
</div>
