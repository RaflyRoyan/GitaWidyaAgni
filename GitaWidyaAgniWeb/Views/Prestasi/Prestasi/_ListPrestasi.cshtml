@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.ListPrestasi
@using GitaWidyaAgniWeb.Infrastructure
@using GitaWidyaAgniWeb.Models.Prestasi

@(Html.DevExtreme().DataGrid<PrestasiVM.PrestasiRow>()
    .ID("tblPrestasi")
    .DataSource(Model.Rows)
    .KeyExpr("EncDecrKey")
    .ListGrid("Prestasi")
    .Columns(columns =>
    {
        columns.AddRowNumber();
        columns.AddFor(m => m.Title).Caption("Prestasi").CssClass("fw-medium");
        columns.AddFor(m => m.RankTitle).Caption("Peringkat");
        columns.AddFor(m => m.Peraih).Caption("Peraih");
        columns.AddFor(m => m.TeamName).Caption("Tim").Visible(false);
        columns.AddFor(m => m.Lomba).Caption("Lomba");
        columns.AddFor(m => m.Level).Caption("Tingkat");
        columns.AddFor(m => m.AchievedDate).Caption("Tanggal").DataType(GridColumnDataType.Date).Format("dd MMM yyyy");
        columns.AddFor(m => m.Publik).Caption("Publik").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate"));
        columns.AddFor(m => m.Disorot).Caption("Disorot").Alignment(HorizontalAlignment.Center).CellTemplate(new JS("AppUI.yesNoTemplate")).Visible(false);
        columns.AddAction("Prestasi.achievementActionTemplate");
    })
)
