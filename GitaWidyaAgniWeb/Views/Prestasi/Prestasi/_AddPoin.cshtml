@model GitaWidyaAgniWeb.Models.Prestasi.PrestasiVM.AddPoin
@using GitaWidyaAgniWeb.Models.Prestasi
@* Poin manual untuk Pemateri / Lainnya. Hadir, Panitia, Pengurus, dan Prestasi dibuat otomatis. *@

<div class="gwa-mform">
    @(Html.DevExtreme().Form<PrestasiVM.NewPoin>()
        .ID("frmPoin")
        .FormData(Model.Row)
        .LabelLocation(FormLabelLocation.Top)
        .ShowColonAfterLabel(false)
        .ColCount(2)
        .ColCountByScreen(c => c.Xs(1).Sm(1))
        .Items(items =>
        {
            items.AddSimpleFor(m => m.MemberId).ColSpan(2).Editor(e => e.SelectBox().DataSource(Model.AnggotaOpsi).ValueExpr("Value").DisplayExpr("Text").SearchEnabled(true));
            items.AddSimpleFor(m => m.SourceType).Editor(e => e.SelectBox().DataSource(Model.SumberOpsi).ValueExpr("Value").DisplayExpr("Text"));
            items.AddSimpleFor(m => m.Points).Editor(e => e.NumberBox().ShowSpinButtons(true).Format("#0"));
            items.AddSimpleFor(m => m.EarnedDate).Editor(e => e.DateBox().DisplayFormat("dd MMM yyyy").DateSerializationFormat("yyyy-MM-dd"));
            items.AddSimpleFor(m => m.PeriodId).Editor(e => e.SelectBox().DataSource(Model.PeriodeOpsi).ValueExpr("Value").DisplayExpr("Text").ShowClearButton(true));
            items.AddSimpleFor(m => m.Notes).ColSpan(2).Editor(e => e.TextBox().MaxLength(255));
        })
    )
    <div class="gwa-mform-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-success" onclick="Prestasi.savePoint()"><i class="ri-save-3-line align-bottom me-1"></i> Simpan</button>
    </div>
</div>
