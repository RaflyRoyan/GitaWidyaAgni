@model GitaWidyaAgniWeb.Models.Prestasi.SertifikatVM.Index
@using GitaWidyaAgniWeb.Infrastructure

@{
    ViewData["Title"] = "Sertifikat";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ri-file-paper-2-line align-bottom me-1"></i> Sertifikat</h5>
        <p class="gwa-card-intro">
            Setiap sertifikat punya kode verifikasi yang bisa dicek publik di
            <a href="@Url.Action("VerifikasiSertifikat", "Landing", new { area = "" })" target="_blank">halaman verifikasi</a>.
            Sertifikat tidak dihapus; cabut bila tidak berlaku.
        </p>
    </div>
    <div class="card-body">
        <partial name="_Toolbar" model='new ToolbarModel("Terbitkan Sertifikat", "Sertifikat.add()",
            ("btn-outline-info", "ri-file-download-line", "Unduh berkas"),
            ("btn-outline-secondary", "ri-qr-code-line", "Salin tautan verifikasi"),
            ("btn-outline-warning", "ri-edit-2-line", "Ubah"),
            ("btn-outline-danger", "ri-forbid-line", "Cabut"),
            ("btn-outline-success", "ri-refresh-line", "Pulihkan"))' />
        <div id="target" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.SertifikatUrl = {
            list: '@Url.Action("List")',
            add: '@Url.Action("Add")',
            edit: '@Url.Action("Edit")',
            opsiReferensi: '@Url.Action("OpsiReferensi")',
            simpanBaru: '@Url.Action("SimpanBaru")',
            update: '@Url.Action("Update")',
            cabut: '@Url.Action("Cabut")',
            pulihkan: '@Url.Action("Pulihkan")',
            unduh: '@Url.Action("Unduh")',
            verifikasi: '@Url.Action("VerifikasiSertifikat", "Landing", new { area = "" }, Context.Request.Scheme)'
        };
    </script>
    <script src="~/Scripts/Prestasi/Sertifikat.js" asp-append-version="true"></script>
}
